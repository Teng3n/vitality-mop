---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Vitality" } = Astro.props;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/roster", label: "Roster" },
  { href: "/calendar", label: "Calendar" },
  { href: "/loot", label: "Loot Summary" },
  { href: "/loot/history", label: "Loot History" },
  { href: "/bench", label: "Bench" },
];

const isActive = (href: string) => {
  const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
  return pathname === href;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Static guild dashboard for a World of Warcraft Mists of Pandaria Classic raid team."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-frame">
      <aside class="side-nav" aria-label="Guild navigation">
        <a class="side-nav-title" href="/">Vitality</a>
        <nav>
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="site-shell">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <span>MoP Classic guild dashboard</span>
          <span>Static data MVP</span>
        </footer>
      </div>
    </div>
  </body>
</html>
