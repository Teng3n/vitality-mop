---
import fs from "node:fs";
import path from "node:path";
import { getArchivedLootTiers, getLootSummaryHref } from "../lib/lootTiers";
import "../styles/global.css";

interface Props {
  title?: string;
}
type SyncMeta = {
  lastDataSyncAt?: string;
};

const { title = "Vitality" } = Astro.props;
const archivedLootTiers = getArchivedLootTiers();
type NavChild = {
  href: string;
  label: string;
};

type NavItem = NavChild & {
  matchPrefix?: string;
  children?: NavChild[];
};

const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/dashboard", label: "Dashboard" },
  { href: "/progression", label: "Progression" },
  {
    href: "/raid-guides/siege-of-orgrimmar",
    label: "Raid Guides",
    matchPrefix: "/raid-guides",
    children: [
      { href: "/raid-guides/siege-of-orgrimmar", label: "Siege of Orgrimmar" },
    ],
  },
  { href: "/bench", label: "Bench" },
  { href: "/roster", label: "Roster" },
  { href: "/calendar", label: "Calendar" },
  {
    href: "/loot",
    label: "Loot",
    matchPrefix: "/loot",
    children: [
      { href: "/loot", label: "Summary" },
      { href: "/loot/history", label: "History" },
      ...archivedLootTiers.map((tier) => ({ href: getLootSummaryHref(tier), label: tier.label })),
    ],
  },
  {
    href: "/officer/tools",
    label: "Officer",
    matchPrefix: "/officer",
    children: [
      { href: "/officer/tools", label: "Tools" },
      { href: "/officer/bis-lists", label: "BiS Lists" },
      { href: "/officer/roster", label: "Roster" },
    ],
  },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (item: NavItem) => {
  const matchPrefix = item.matchPrefix ?? "";
  return pathname === item.href || (typeof matchPrefix === "string" && matchPrefix.length > 0 && pathname.startsWith(matchPrefix));
};

const isExactActive = (href: string) => pathname === href;
const readSyncMeta = (): SyncMeta => {
  try {
    return JSON.parse(fs.readFileSync(path.join(process.cwd(), "src/data/syncMeta.json"), "utf8")) as SyncMeta;
  } catch {
    return {};
  }
};
const formatLastDataSync = (value?: string) => {
  if (!value) {
    return "Unknown";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Unknown";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZone: "America/Los_Angeles",
  }).format(date);
};
const syncMeta = readSyncMeta();
const lastDataSync = formatLastDataSync(syncMeta.lastDataSyncAt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Static guild site for a World of Warcraft Mists of Pandaria Classic raid team."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-frame">
      <aside class="side-nav" aria-label="Guild navigation">
        <a class="side-nav-title" href="/">Vitality</a>
        <nav>
          {
            navItems.map((item) =>
              item.children ? (
                <div class="side-nav-group" data-active={isActive(item) ? "true" : undefined}>
                  <a class="side-nav-parent" href={item.href}>
                    {item.label}
                  </a>
                  <div class="side-nav-subitems">
                    {item.children.map((child) => (
                      <a href={child.href} aria-current={isExactActive(child.href) ? "page" : undefined}>
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a href={item.href} aria-current={isActive(item) ? "page" : undefined}>
                  {item.label}
                </a>
              ),
            )
          }
        </nav>
      </aside>

      <div class="site-shell">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <span>Vitality Guild Tools</span>
          <span class="site-footer-sync">Last data sync: {lastDataSync}</span>
        </footer>
      </div>
    </div>
  </body>
</html>
