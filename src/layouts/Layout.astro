---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Vitality" } = Astro.props;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/dashboard", label: "Dashboard" },
  { href: "/roster", label: "Roster" },
  { href: "/calendar", label: "Calendar" },
  { href: "/loot", label: "Loot Summary" },
  { href: "/loot/history", label: "Loot History" },
  { href: "/bench", label: "Bench" },
];

const isActive = (href: string) => {
  const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
  return pathname === href;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Static guild site for a World of Warcraft Mists of Pandaria Classic raid team."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-frame">
      <aside class="side-nav" aria-label="Guild navigation">
        <a class="side-nav-title" href="/">Vitality</a>
        <nav>
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="site-shell">
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <span>MoP Classic guild site</span>
          <span class="sync-trigger">
            <button class="sync-trigger-button" type="button" data-sync-trigger>Sync Data</button>
            <span class="sync-trigger-status" data-sync-trigger-status aria-live="polite"></span>
          </span>
        </footer>
      </div>
    </div>
    <script>
      const syncButton = document.querySelector<HTMLButtonElement>("[data-sync-trigger]");
      const syncStatus = document.querySelector<HTMLElement>("[data-sync-trigger-status]");

      syncButton?.addEventListener("click", async () => {
        const password = window.prompt("Enter sync password");

        if (!password) {
          return;
        }

        syncButton.disabled = true;
        syncButton.textContent = "Syncing...";

        if (syncStatus) {
          syncStatus.textContent = "";
        }

        try {
          const response = await fetch("/api/trigger-sync", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ password }),
          });
          const result = (await response.json().catch(() => undefined)) as { message?: string } | undefined;
          const message =
            result?.message ?? (response.ok ? "Sync workflow triggered." : "Unable to trigger sync workflow.");

          if (syncStatus) {
            syncStatus.textContent = message;
            syncStatus.dataset.state = response.ok ? "success" : "error";
          }
        } catch {
          if (syncStatus) {
            syncStatus.textContent = "Unable to trigger sync workflow.";
            syncStatus.dataset.state = "error";
          }
        } finally {
          syncButton.disabled = false;
          syncButton.textContent = "Sync Data";
        }
      });
    </script>
  </body>
</html>
