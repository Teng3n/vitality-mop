---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Vitality" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Static guild dashboard for a World of Warcraft Mists of Pandaria Classic raid team."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>MoP Classic guild dashboard</span>
        <span>Static data MVP</span>
      </footer>
    </div>
  </body>
</html>
