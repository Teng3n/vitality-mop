---
import {
  formatKillRecordBossLabel,
  getBestCompletedDifficulty,
  getDifficulty,
  getDifficultyStatus,
  getProgressBreakdownForTier,
  getRaidProgressionKill,
  getRaidProgress,
  getSortedBosses,
  isTierUnreleased,
  tierDisplaysDifficulties,
  type DifficultyStatus,
  type ProgressionBoss,
  type ProgressionDifficulty,
  type ProgressionRaid,
  type ProgressionTier,
} from "../lib/progressionTiers";

interface Props {
  raid: ProgressionRaid;
  tier: ProgressionTier;
}

const { raid, tier } = Astro.props;

const formatDate = (value?: string | null) => {
  if (!value) {
    return "";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};

const formatPercent = (value?: number | null) => {
  if (typeof value !== "number" || !Number.isFinite(value)) {
    return "";
  }

  return `${Number.isInteger(value) ? value : value.toFixed(1)}%`;
};

const getStatusClass = (status: DifficultyStatus) =>
  status === "Killed" ? "is-killed" : status === "Best Pull" ? "is-best-pull" : "is-no-data";

const getDifficultyMeta = (difficulty?: ProgressionDifficulty) => {
  const status = getDifficultyStatus(difficulty);
  const firstKillDate = formatDate(difficulty?.firstKillDate);
  const bestPercent = status === "Best Pull" ? formatPercent(difficulty?.bestPercent) : "";

  return {
    status,
    firstKillDate,
    bestPercent,
    reportUrl: difficulty?.reportUrl || "",
  };
};

const getBestPullMeta = (boss: ProgressionBoss) => {
  const candidates = Object.values(boss.difficulties ?? {})
    .map((difficulty) => getDifficultyMeta(difficulty))
    .filter((meta) => meta.status === "Best Pull");

  return candidates.sort((a, b) => {
    const aPercent = Number.parseFloat(a.bestPercent) || Number.POSITIVE_INFINITY;
    const bPercent = Number.parseFloat(b.bestPercent) || Number.POSITIVE_INFINITY;

    return aPercent - bPercent;
  })[0];
};

const getSingleDifficultyRows = (boss: ProgressionBoss) => {
  const bestDifficultyName = getBestCompletedDifficulty(boss);

  if (bestDifficultyName) {
    return [{ name: "", meta: getDifficultyMeta(getDifficulty(boss, bestDifficultyName)) }];
  }

  const bestPullMeta = getBestPullMeta(boss);

  return [{ name: "", meta: bestPullMeta ?? getDifficultyMeta(undefined) }];
};

const getBossDifficultyRows = (boss: ProgressionBoss) => {
  if (!tierDisplaysDifficulties(tier)) {
    return getSingleDifficultyRows(boss);
  }

  const normalMeta = getDifficultyMeta(getDifficulty(boss, "Normal"));
  const heroicMeta = getDifficultyMeta(getDifficulty(boss, "Heroic"));

  if (heroicMeta.status === "Killed") {
    return [{ name: "Heroic", meta: heroicMeta }];
  }

  if (normalMeta.status === "Killed") {
    return [
      { name: "Normal", meta: normalMeta },
      { name: "Heroic", meta: heroicMeta },
    ];
  }

  const normalScore = normalMeta.status === "Best Pull" ? 1 : 0;
  const heroicScore = heroicMeta.status === "Best Pull" ? 1 : 0;

  return heroicScore > normalScore
    ? [
        { name: "Heroic", meta: heroicMeta },
        { name: "Normal", meta: normalMeta },
      ]
    : [
        { name: "Normal", meta: normalMeta },
        { name: "Heroic", meta: heroicMeta },
      ];
};

const progress = getRaidProgress(raid);
const progressionKill = getRaidProgressionKill(raid);
const isUnreleased = isTierUnreleased(tier);
const isComplete = progress.totalBosses > 0 && progress.killedBosses === progress.totalBosses;
const raidProgressBreakdown = getProgressBreakdownForTier(progress, tier);
const progressionLabel = isUnreleased ? "Status" : progress.killedBosses > 0 && !isComplete ? "Progressed To" : "Completed";
const progressionValue = isUnreleased ? "Unreleased" : progressionKill ? formatKillRecordBossLabel(progressionKill, tier) : "No kills";
const progressionDate = progressionKill ? formatDate(progressionKill.date) : "";
---

<section class="panel progression-raid-panel">
  <div class="section-heading inline">
    <div>
      <p class="eyebrow">Raid</p>
      <h2>{raid.name || "Unknown Raid"}</h2>
      <p class="info-note">
        Progress {progress.killedBosses} / {progress.totalBosses}
        {raidProgressBreakdown && (
          <>
            {" "}<span aria-hidden="true">&middot;</span>{" "}
            {raidProgressBreakdown}
          </>
        )}
      </p>
    </div>
    <div class="progression-raid-latest">
      <span>{progressionLabel}</span>
      <strong>{progressionValue}</strong>
      {progressionDate && <small>{progressionDate}</small>}
    </div>
  </div>

  <div class="progression-boss-grid">
    {getSortedBosses(raid).map((boss) => {
      const difficultyRows = getBossDifficultyRows(boss);

      return (
        <article class="progression-boss-card">
          <h3>{boss.name || "Unknown Boss"}</h3>
          {difficultyRows.map(({ name: difficultyName, meta }) => (
            <section class="progression-difficulty">
              <div class="progression-difficulty-head">
                {difficultyName && <span>{difficultyName}</span>}
                <strong class={`progression-status ${getStatusClass(meta.status)}`}>{meta.status}</strong>
              </div>

              <dl class="progression-detail-list">
                {meta.firstKillDate && (
                  <div>
                    <dt>First Kill</dt>
                    <dd>{meta.firstKillDate}</dd>
                  </div>
                )}
                {meta.bestPercent && (
                  <div>
                    <dt>Best pull</dt>
                    <dd>{meta.bestPercent}</dd>
                  </div>
                )}
              </dl>

              {meta.reportUrl && (
                <a class="progression-log-link" href={meta.reportUrl} target="_blank" rel="noreferrer">
                  View Log
                </a>
              )}
            </section>
          ))}
        </article>
      );
    })}
  </div>
</section>
