---
import { getBenchSuggestionText } from "../lib/benchSuggestions";
import { getTodayIso } from "../lib/guildData";

const benchSuggestionText = getBenchSuggestionText(getTodayIso());
---

<section class="panel bench-suggestion-tool" data-bench-suggestion-tool>
  <div class="section-heading inline bench-suggestion-heading">
    <div>
      <p class="eyebrow">Bench Suggestions</p>
      <h2>Bench Suggestions</h2>
      <p class="info-note">
        Generate a draft bench plan using the current roster, calendar statuses, and Bench Rules.
        Review before copying into the Google Sheet.
      </p>
    </div>
    <div class="bench-suggestion-actions">
      <button class="filter-button is-subtle" type="button" data-bench-suggestion-toggle>
        Generate Bench Suggestions
      </button>
      <button class="filter-button is-subtle" type="button" data-bench-suggestion-copy hidden>
        Copy
      </button>
    </div>
  </div>

  <div class="bench-suggestion-output" data-bench-suggestion-output hidden>
    <pre>{benchSuggestionText}</pre>
  </div>
  <p class="info-note bench-suggestion-status" data-bench-suggestion-status aria-live="polite"></p>
</section>

<script>
  const benchSuggestionTools = Array.from(document.querySelectorAll<HTMLElement>("[data-bench-suggestion-tool]"));

  for (const benchSuggestionTool of benchSuggestionTools) {
    const benchSuggestionToggle = benchSuggestionTool.querySelector<HTMLButtonElement>("[data-bench-suggestion-toggle]");
    const benchSuggestionCopy = benchSuggestionTool.querySelector<HTMLButtonElement>("[data-bench-suggestion-copy]");
    const benchSuggestionOutput = benchSuggestionTool.querySelector<HTMLElement>("[data-bench-suggestion-output]");
    const benchSuggestionStatus = benchSuggestionTool.querySelector<HTMLElement>("[data-bench-suggestion-status]");

    benchSuggestionToggle?.addEventListener("click", () => {
      if (!benchSuggestionOutput || !benchSuggestionCopy) {
        return;
      }

      const isHidden = benchSuggestionOutput.hidden;
      benchSuggestionOutput.hidden = !isHidden;
      benchSuggestionCopy.hidden = !isHidden;
      benchSuggestionToggle.textContent = isHidden ? "Hide Bench Suggestions" : "Generate Bench Suggestions";

      if (benchSuggestionStatus) {
        benchSuggestionStatus.textContent = "";
      }
    });

    benchSuggestionCopy?.addEventListener("click", async () => {
      const suggestionText = benchSuggestionOutput?.textContent?.trim() ?? "";

      if (!suggestionText) {
        return;
      }

      try {
        await navigator.clipboard.writeText(suggestionText);

        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Bench suggestions copied.";
        }
      } catch {
        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Unable to copy automatically.";
        }
      }
    });
  }
</script>
