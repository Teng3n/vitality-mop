---
import { getPlayerClass, getPlayerClassColor, getPlayerNameStyle } from "../lib/playerStyles";
import { cleanPlayerName, getPlayerProfileHref } from "../lib/playerNames";

export interface CalendarSummary {
  label: string;
  values: Record<string, string>;
}

export interface CalendarPlayer {
  name: string;
  bis: number;
  major: number;
  minor: number;
  total: number;
  bonusRolls: number;
  offspec: number;
  mia: number;
  out: number;
  late: number;
  bench: number;
  schedule: Record<string, string>;
}

export interface RaidDate {
  label: string;
  isoDate: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  mode?: "snapshot" | "history";
  summaryStrategy?: "visible" | "next-raid-day" | "raid-week";
  windowSize?: number;
  showSummaryCards?: boolean;
  showDateRangeControls?: boolean;
  calendar: {
    raidDates: RaidDate[];
    summary: CalendarSummary[];
    players: CalendarPlayer[];
  };
}

const {
  eyebrow = "Raid Assignments",
  title = "Upcoming Raid Window",
  description = "",
  mode = "snapshot",
  summaryStrategy = "visible",
  windowSize = 12,
  showSummaryCards = true,
  showDateRangeControls = false,
  calendar,
} = Astro.props;
const statusTypes = ["Bench", "Out", "Late", "MIA", "Trial"];
const summaryTypes = ["Out", "Late", "Bench", "MIA", "Trial"];
const statusDescriptions: Record<string, string> = {
  Bench: "Player is assigned bench for the day.",
  Out: "Player has posted out for the day.",
  Late: "Player has posted late for the day.",
  MIA: "Player was missing from raid with no post out.",
  Trial: "Player was on trial for the raid.",
};
const slugStatus = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const statusClass = (value: string) => (value ? `calendar-status status-${slugStatus(value)}` : "calendar-empty");
const isWeekBoundary = (isoDate: string, index: number) => {
  if (index === 0) {
    return false;
  }

  const [year, month, day] = isoDate.split("-").map(Number);
  return new Date(year, month - 1, day).getDay() === 0;
};
const summaryRows = summaryTypes
  .map((label) => calendar.summary.find((row) => row.label === label))
  .filter((row): row is CalendarSummary => Boolean(row));
const showSummaryLists = mode === "snapshot";
---

<section
  class="panel raid-window-panel"
  data-raid-window
  data-calendar-mode={mode}
  data-summary-strategy={summaryStrategy}
  data-window-size={windowSize}
>
  <div class="section-heading inline">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 data-raid-window-title>{title}</h2>
      {description && <p class="muted">{description}</p>}
    </div>
    <div class="status-legend" aria-label="Calendar status legend">
      {
        statusTypes.map((status) => (
          <span
            class={`calendar-status status-${slugStatus(status)}`}
            title={statusDescriptions[status]}
            aria-label={`${status}: ${statusDescriptions[status]}`}
          >
            {status}
          </span>
        ))
      }
    </div>
  </div>

  {
    showSummaryCards && (
      <div class="calendar-summary-cards" aria-label="Calendar status totals">
        {summaryRows.map((row) => (
          <article
            class={`calendar-summary-card status-${slugStatus(row.label)}`}
            data-summary-card
            data-summary-status={row.label}
            data-summary-values={JSON.stringify(row.values)}
            title={statusDescriptions[row.label]}
            aria-label={`${row.label}: ${statusDescriptions[row.label]}`}
          >
            <div class="calendar-summary-card-header">
              <span>{row.label}</span>
              <strong data-summary-total>0</strong>
            </div>
            {showSummaryLists && <ul class="calendar-summary-list" data-summary-list></ul>}
            <small data-summary-detail>Visible dates</small>
          </article>
        ))}
      </div>
    )
  }

  {
    showDateRangeControls && (
      <form class="calendar-filter" data-calendar-filter>
        <label class="field calendar-filter-field">
          <span>Start date</span>
          <input type="date" data-calendar-start />
        </label>
        <label class="field calendar-filter-field">
          <span>End date</span>
          <input type="date" data-calendar-end />
        </label>
        <div class="calendar-filter-actions">
          <button class="filter-button" type="submit">Apply</button>
          <button class="filter-button is-subtle" type="button" data-calendar-reset>
            Reset to next 6 weeks
          </button>
        </div>
        <span class="muted calendar-filter-detail" data-calendar-filter-detail></span>
      </form>
    )
  }

  {
    mode === "history" && (
      <div class="raid-window-toolbar">
        <span class="muted" data-raid-window-label>Upcoming raids</span>
      </div>
    )
  }

  <p class="info-note calendar-window-empty" data-calendar-empty hidden>No raid days in selected date range.</p>

  <div class="calendar-shell calendar-window-shell">
    <table class="calendar-table calendar-window-table">
      <thead>
        <tr>
          <th class="calendar-player">Player</th>
          {
            calendar.raidDates.map((date, index) => (
              <th
                data-raid-date={date.isoDate}
                data-raid-label={date.label}
                data-week-boundary={isWeekBoundary(date.isoDate, index) ? "true" : undefined}
              >
                {date.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          calendar.players.map((player) => (
            <tr
              data-calendar-player-row
              data-player-color={getPlayerClassColor(player.name)}
              data-player-href={getPlayerProfileHref(player.name)}
            >
              <th class="calendar-player">
                <a
                  class="player-name"
                  href={getPlayerProfileHref(player.name)}
                  style={getPlayerNameStyle(player.name)}
                  title={getPlayerClass(player.name)}
                >
                  {cleanPlayerName(player.name)}
                </a>
              </th>
              {
                calendar.raidDates.map((date, index) => {
                  const status = player.schedule[date.label] ?? "";
                  return (
                    <td
                      class={statusClass(status)}
                      data-raid-date={date.isoDate}
                      data-calendar-status={status}
                      data-week-boundary={isWeekBoundary(date.isoDate, index) ? "true" : undefined}
                      title={status ? `${player.name}: ${status} on ${date.label}` : undefined}
                    >
                      {status}
                    </td>
                  );
                })
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  const toLocalDate = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const parseIsoDate = (isoDate: string) => {
    const [year, month, day] = isoDate.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const getWeekStart = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate() - date.getDay());
  const asNumber = (value: unknown) => {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : 0;
  };
  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "\"": "&quot;",
        "'": "&#39;",
      };

      return entities[character] ?? character;
    });

  document.querySelectorAll<HTMLElement>("[data-raid-window]").forEach((panel) => {
    const mode = panel.dataset.calendarMode ?? "snapshot";
    const summaryStrategy = panel.dataset.summaryStrategy ?? "visible";
    const windowSize = Number(panel.dataset.windowSize ?? 12);
    const titleNode = panel.querySelector<HTMLElement>("[data-raid-window-title]");
    const label = panel.querySelector<HTMLElement>("[data-raid-window-label]");
    const filterForm = panel.querySelector<HTMLFormElement>("[data-calendar-filter]");
    const startInput = panel.querySelector<HTMLInputElement>("[data-calendar-start]");
    const endInput = panel.querySelector<HTMLInputElement>("[data-calendar-end]");
    const resetButton = panel.querySelector<HTMLButtonElement>("[data-calendar-reset]");
    const filterDetail = panel.querySelector<HTMLElement>("[data-calendar-filter-detail]");
    const emptyState = panel.querySelector<HTMLElement>("[data-calendar-empty]");
    const tableShell = panel.querySelector<HTMLElement>(".calendar-window-shell");
    const dateHeaders = Array.from(panel.querySelectorAll<HTMLElement>("thead [data-raid-date]"));
    const datedCells = Array.from(panel.querySelectorAll<HTMLElement>("[data-raid-date]"));
    const playerRows = Array.from(panel.querySelectorAll<HTMLTableRowElement>("[data-calendar-player-row]"));
    const summaryCards = Array.from(panel.querySelectorAll<HTMLElement>("[data-summary-card]"));
    const uniqueDates = dateHeaders
      .map((header) => ({
        isoDate: header.dataset.raidDate ?? "",
        label: header.dataset.raidLabel ?? header.textContent?.trim() ?? "",
      }))
      .filter((date) => date.isoDate)
      .map((date) => ({ ...date, date: parseIsoDate(date.isoDate) }));
    const today = toLocalDate(new Date());
    const nextRaidDate = uniqueDates.find(({ date }) => date >= today) ?? uniqueDates[uniqueDates.length - 1];
    const getDefaultVisibleDates = () => {
      if (mode === "history") {
        return uniqueDates;
      }

      const currentWeekStart = getWeekStart(today);
      const currentWeekDates = uniqueDates.filter(
        ({ date }) => getWeekStart(date).getTime() === currentWeekStart.getTime(),
      );
      const hasCurrentOrUpcomingRaidThisWeek = currentWeekDates.some(({ date }) => date >= today);
      const windowStart =
        hasCurrentOrUpcomingRaidThisWeek && (today.getDay() === 0 || today.getDay() === 1)
          ? currentWeekStart
          : nextRaidDate
            ? getWeekStart(nextRaidDate.date)
            : getWeekStart(uniqueDates[uniqueDates.length - 1]?.date ?? today);

      const defaultDates = uniqueDates.filter(({ date }) => date >= windowStart).slice(0, windowSize);

      if (defaultDates.length === 0) {
        return uniqueDates.slice(-windowSize);
      }

      return defaultDates;
    };

    let visibleDates = getDefaultVisibleDates();
    const getRaidWeekDates = () => {
      const currentWeekStart = getWeekStart(today);
      const currentWeekDates = uniqueDates.filter(
        ({ date }) => getWeekStart(date).getTime() === currentWeekStart.getTime(),
      );
      const hasCurrentOrUpcomingRaidThisWeek = currentWeekDates.some(({ date }) => date >= today);
      const targetWeekStart =
        hasCurrentOrUpcomingRaidThisWeek && (today.getDay() === 0 || today.getDay() === 1)
          ? currentWeekStart
          : nextRaidDate
            ? getWeekStart(nextRaidDate.date)
            : getWeekStart(uniqueDates[uniqueDates.length - 1]?.date ?? today);

      return uniqueDates.filter(({ date }) => getWeekStart(date).getTime() === targetWeekStart.getTime()).slice(0, 2);
    };

    const formatRangeDate = (date: Date) =>
      date.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
      });
    const formatHeadingDate = (date: Date) => {
      const day = date.getDate();
      let suffix = "th";

      if (day % 10 === 1 && day !== 11) {
        suffix = "st";
      } else if (day % 10 === 2 && day !== 12) {
        suffix = "nd";
      } else if (day % 10 === 3 && day !== 13) {
        suffix = "rd";
      }

      const month = date.toLocaleDateString(undefined, { month: "long" });

      return `${month} ${day}${suffix}`;
    };
    const formatInputRange = (dates: typeof uniqueDates) => {
      if (!startInput || !endInput) {
        return;
      }

      startInput.value = dates[0]?.isoDate ?? "";
      endInput.value = dates[dates.length - 1]?.isoDate ?? "";
    };
    const getSummaryDates = () =>
      summaryStrategy === "raid-week"
        ? getRaidWeekDates()
        : summaryStrategy === "next-raid-day" && nextRaidDate
          ? [nextRaidDate]
          : visibleDates;
    const formatSummaryRange = (summaryDates: typeof uniqueDates) => {
      if (summaryDates.length === 0) {
        return "No raid dates";
      }

      if (summaryDates.length === 1) {
        return summaryDates[0].label;
      }

      return `${summaryDates[0].label} - ${summaryDates[summaryDates.length - 1].label}`;
    };
    const formatFilterDetail = () => {
      if (!filterDetail) {
        return;
      }

      if (visibleDates.length === 0) {
        const start = startInput?.value || "beginning";
        const end = endInput?.value || "end";
        filterDetail.textContent = `No raid days from ${start} through ${end}`;
        return;
      }

      const first = visibleDates[0].date;
      const last = visibleDates[visibleDates.length - 1].date;
      filterDetail.textContent = `Showing ${visibleDates.length} raid nights, ${formatRangeDate(first)} - ${formatRangeDate(last)}`;
    };
    const applyCustomRange = () => {
      const startValue = startInput?.value ?? "";
      const endValue = endInput?.value ?? "";

      visibleDates = uniqueDates.filter(
        ({ isoDate }) => (!startValue || isoDate >= startValue) && (!endValue || isoDate <= endValue),
      );
      updateRows();
    };
    const resetDefaultRange = () => {
      visibleDates = getDefaultVisibleDates();
      formatInputRange(visibleDates);
      updateRows();
    };

    const updateRows = () => {
      const visibleDateSet = new Set(visibleDates.map(({ isoDate }) => isoDate));
      const firstVisibleDate = visibleDates[0]?.isoDate ?? "";
      const summaryDates = getSummaryDates();
      const summaryDateSet = new Set(summaryDates.map(({ isoDate }) => isoDate));

      if (tableShell) {
        tableShell.hidden = visibleDates.length === 0;
      }

      if (emptyState) {
        emptyState.hidden = visibleDates.length > 0;
      }

      for (const cell of datedCells) {
        const raidDate = cell.dataset.raidDate ?? "";
        cell.hidden = !visibleDateSet.has(raidDate);
        cell.toggleAttribute("data-window-start", raidDate === firstVisibleDate);
      }

      let visiblePlayerRows = 0;

      for (const row of playerRows) {
        row.hidden = false;
        visiblePlayerRows += 1;
      }

      for (const card of summaryCards) {
        const values = JSON.parse(card.dataset.summaryValues ?? "{}") as Record<string, string>;
        const status = card.dataset.summaryStatus ?? "";
        const playerMap = new Map<string, { dates: string[]; color: string; href: string }>();

        if (summaryStrategy === "raid-week") {
          for (const row of playerRows) {
            const playerName = row.querySelector<HTMLElement>(".calendar-player")?.textContent?.trim() ?? "";
            const playerColor = row.dataset.playerColor ?? "";
            const playerHref = row.dataset.playerHref ?? "";

            for (const cell of Array.from(row.querySelectorAll<HTMLElement>("[data-calendar-status]"))) {
              const date = uniqueDates.find(({ isoDate }) => isoDate === cell.dataset.raidDate);

              if (playerName && date && summaryDateSet.has(date.isoDate) && cell.dataset.calendarStatus === status) {
                const entry = playerMap.get(playerName) ?? { dates: [], color: playerColor, href: playerHref };
                entry.dates.push(date.label);
                playerMap.set(playerName, entry);
              }
            }
          }
        }

        const total =
          summaryStrategy === "raid-week"
            ? playerMap.size
            : summaryDates.reduce((sum, date) => sum + asNumber(values[date.label]), 0);
        const activeDates = summaryDates.filter((date) => asNumber(values[date.label]) > 0).length;
        const totalNode = card.querySelector<HTMLElement>("[data-summary-total]");
        const detailNode = card.querySelector<HTMLElement>("[data-summary-detail]");
        const listNode = card.querySelector<HTMLElement>("[data-summary-list]");

        if (totalNode) {
          totalNode.textContent = String(total);
        }

        if (detailNode) {
          detailNode.textContent =
            mode === "history"
              ? `${activeDates} raid nights in history`
              : summaryStrategy === "raid-week"
                ? formatSummaryRange(summaryDates)
              : summaryStrategy === "next-raid-day"
                ? `${summaryDates[0]?.label ?? "Next raid"} only`
              : `${activeDates} upcoming raid nights`;
        }

        if (listNode) {
          if (playerMap.size === 0) {
            listNode.replaceChildren();
          } else {
            listNode.innerHTML = Array.from(playerMap.entries())
              .map(([playerName, entry]) => {
                const { dates, color, href } = entry;
                const uniqueLabels = [...new Set(dates)];
                const needsDateLabel = uniqueLabels.length !== summaryDates.length;
                const suffix = needsDateLabel ? ` <small>${escapeHtml(uniqueLabels.join(", "))}</small>` : "";
                const style = color ? ` style="--player-color: ${escapeHtml(color)}"` : "";
                const hrefAttribute = href ? ` href="${escapeHtml(href)}"` : "";
                return `<li><a class="player-name player-link"${hrefAttribute}${style}>${escapeHtml(playerName)}</a>${suffix}</li>`;
              })
              .join("");
          }
        }
      }

      if (visibleDates.length > 0) {
        const first = visibleDates[0].date;
        const last = visibleDates[visibleDates.length - 1].date;

        if (titleNode && mode !== "history") {
          titleNode.textContent = `${formatHeadingDate(first)} through ${formatHeadingDate(last)}`;
        }

        if (label) {
          const range = `${formatRangeDate(first)} - ${formatRangeDate(last)}`;
          label.textContent = `${visibleDates.length} raid nights, ${range} (${visiblePlayerRows} roster rows)`;
        }
      } else if (titleNode && mode !== "history") {
        titleNode.textContent = "No raid days in selected range";
      }

      formatFilterDetail();
    };

    if (filterForm) {
      formatInputRange(visibleDates);
      filterForm.addEventListener("submit", (event) => {
        event.preventDefault();
        applyCustomRange();
      });
    }

    resetButton?.addEventListener("click", resetDefaultRange);
    updateRows();
  });
</script>
