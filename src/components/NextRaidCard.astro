---
import benchRules from "../data/benchRules.json";
import { getPlayerClass, getPlayerClassColor } from "../lib/playerStyles";
import { cleanPlayerName, getPlayerProfileHref } from "../lib/playerNames";
import { activeRosterPlayers, getPlayerByName } from "../lib/guildData";

interface RaidDate {
  label: string;
  isoDate: string;
}

interface CalendarPlayer {
  name: string;
  schedule: Record<string, string>;
}

interface Props {
  calendar: {
    raidDates: RaidDate[];
    players: CalendarPlayer[];
  };
}

const { calendar } = Astro.props;
const activeRosterCount = activeRosterPlayers.length;
const activeRosterPayload = activeRosterPlayers.map((player) => ({
  slug: player.slug,
  name: player.name,
  className: player.className,
  spec: player.spec,
  role: player.role,
}));
const getCalendarStatusPlayer = (name: string) => {
  const rosterPlayer = getPlayerByName(name);
  const cleanedName = cleanPlayerName(rosterPlayer?.name ?? name);

  return {
    slug: rosterPlayer?.slug ?? cleanedName.toLocaleLowerCase(),
    name: cleanedName,
    className: rosterPlayer?.className ?? getPlayerClass(name),
    spec: rosterPlayer?.spec,
    role: rosterPlayer?.role,
    color: getPlayerClassColor(name),
    href: getPlayerProfileHref(cleanedName),
    activeRoster: Boolean(rosterPlayer),
  };
};
const raidPayload = calendar.raidDates.map((date) => ({
  ...date,
  bench: calendar.players
    .filter((player) => player.schedule[date.label] === "Bench")
    .map((player) => getCalendarStatusPlayer(player.name)),
  out: calendar.players
    .filter((player) => player.schedule[date.label] === "Out")
    .map((player) => getCalendarStatusPlayer(player.name)),
  late: calendar.players
    .filter((player) => player.schedule[date.label] === "Late")
    .map((player) => getCalendarStatusPlayer(player.name)),
  mia: calendar.players
    .filter((player) => player.schedule[date.label] === "MIA")
    .map((player) => getCalendarStatusPlayer(player.name)),
}));
---

<section class="panel next-raid-card dashboard-raid-card" data-next-raid data-active-roster-count={activeRosterCount}>
  <div class="next-raid-heading">
    <div>
      <p class="eyebrow">Raider Dashboard</p>
      <h2>Raid Readiness</h2>
    </div>
    <span class="muted">Next raid: <span data-next-raid-date>Upcoming raid</span></span>
  </div>

  <div class="next-raid-grid">
    <div class="next-raid-statuses is-week">
      <article class="next-raid-list next-raid-list-count" data-available-card>
        <div>
          <span>Available</span>
        </div>
        <div class="available-raiders">
          <strong data-week-raiders-count>{activeRosterCount}</strong>
          <span>players</span>
        </div>
      </article>
      <article class="next-raid-list">
        <div>
          <span>Bench this week</span>
          <strong data-week-bench-count>0</strong>
        </div>
        <ul data-week-bench></ul>
      </article>
      <article class="next-raid-list">
        <div>
          <span>Out this week</span>
          <strong data-week-out-count>0</strong>
        </div>
        <ul data-week-out></ul>
      </article>
      <article class="next-raid-list">
        <div>
          <span>Late this week</span>
          <strong data-week-late-count>0</strong>
        </div>
        <ul data-week-late></ul>
      </article>
    </div>

    <section class="readiness-panel" data-readiness-panel>
      <div class="readiness-status">
        <span>Readiness</span>
        <strong data-readiness-status>Ready</strong>
        <small data-readiness-detail>25 raid-ready players.</small>
      </div>
      <div class="readiness-columns" data-readiness-columns>
        <div class="readiness-column" data-readiness-passing-column>
          <span class="readiness-column-label">Passing</span>
          <ul class="readiness-checks" data-readiness-passing></ul>
        </div>
        <div class="readiness-column" data-readiness-warnings-column>
          <div class="readiness-column-head">
            <span class="readiness-column-label">Warnings</span>
            <strong data-readiness-warning-count>0 warnings</strong>
          </div>
          <div class="readiness-warning-groups" data-readiness-warnings></div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/json" data-next-raid-data set:html={JSON.stringify(raidPayload)} />
  <script is:inline type="application/json" data-active-roster-data set:html={JSON.stringify(activeRosterPayload)} />
  <script is:inline type="application/json" data-bench-rules-data set:html={JSON.stringify(benchRules)} />
</section>

<script>
  import { getRaidBuffCoverage } from "../lib/raidBuffs";

  type DashboardPlayer = {
    slug: string;
    name: string;
    className?: string;
    spec?: string;
    role?: string;
    color?: string;
    href?: string;
    activeRoster?: boolean;
  };
  type ReadinessItem = {
    text: string;
    detail?: string;
    group?: string;
  };
  type BenchRules = {
    neverBenchPlayers?: string[];
    avoidBenchingTogether?: [string, string][];
    minimumAvailableByRole?: Record<string, number>;
    minimumAvailableByClass?: Record<string, number>;
    requireAtLeastOneAvailablePerClass?: boolean;
    minimumAvailablePerClass?: number;
  };

  const toLocalDate = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const parseIsoDate = (isoDate: string) => {
    const [year, month, day] = isoDate.split("-").map(Number);
    return new Date(year, month - 1, day);
  };
  const getWeekStart = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate() - date.getDay());
  const ordinal = (day: number) => {
    const rem100 = day % 100;
    if (rem100 >= 11 && rem100 <= 13) {
      return `${day}th`;
    }

    const suffix = day % 10 === 1 ? "st" : day % 10 === 2 ? "nd" : day % 10 === 3 ? "rd" : "th";
    return `${day}${suffix}`;
  };
  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "\"": "&quot;",
        "'": "&#39;",
      };

      return entities[character] ?? character;
    });
  const normalizeKey = (value: string) => value.toLocaleLowerCase().replace(/[^a-z0-9]+/g, "");
  const plural = (count: number, singular: string, pluralLabel = `${singular}s`) => `${count} ${count === 1 ? singular : pluralLabel}`;
  const pluralizeLabel = (label: string) => (label.endsWith("s") ? label : `${label}s`);
  const formatMinimumCheck = (label: string, available: number, minimum: number) =>
    `${pluralizeLabel(label)}: ${available} / ${minimum}`;
  const makeItem = (text: string, detail?: string, group?: string): ReadinessItem => ({ text, detail, group });
  const formatStatusList = (statuses: string[]) =>
    statuses.length <= 2
      ? statuses.join(" and ")
      : `${statuses.slice(0, -1).join(", ")}, and ${statuses[statuses.length - 1]}`;
  const playerListHtml = (players: DashboardPlayer[]) =>
    players
      .map((player) => {
        const color = player.color ? ` style="--player-color: ${escapeHtml(player.color)}"` : "";
        const title = player.className ? ` title="${escapeHtml(player.className)}"` : "";
        const href = player.href ? ` href="${escapeHtml(player.href)}"` : "";
        return `<li><a class="player-name player-link"${href}${color}${title}>${escapeHtml(player.name)}</a></li>`;
      })
      .join("");
  const uniquePlayers = (players: DashboardPlayer[]) => {
    const byPlayer = new Map<string, DashboardPlayer>();

    for (const player of players) {
      byPlayer.set(player.slug || player.href || player.name.toLocaleLowerCase(), player);
    }

    return [...byPlayer.values()].sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: "base" }));
  };
  const getAvailableCounts = (activeRoster: DashboardPlayer[], unavailableSlugs: Set<string>, benchSlugs: Set<string>) => {
    const byRole = new Map<string, number>();
    const byClass = new Map<string, number>();

    for (const player of activeRoster) {
      if (unavailableSlugs.has(player.slug) || benchSlugs.has(player.slug)) {
        continue;
      }

      if (player.role) {
        const roleKey = normalizeKey(player.role);
        byRole.set(roleKey, (byRole.get(roleKey) ?? 0) + 1);
      }

      if (player.className) {
        const classKey = normalizeKey(player.className);
        byClass.set(classKey, (byClass.get(classKey) ?? 0) + 1);
      }
    }

    return { byRole, byClass };
  };
  const formatRoleMinimum = (role: string, available: number, minimum: number) => {
    const roleKey = normalizeKey(role);
    const label = roleKey === "healer" ? "Healer" : role;
    return formatMinimumCheck(label, available, minimum);
  };
  const uniqueReadinessItems = (items: ReadinessItem[]) => {
    const byText = new Map<string, ReadinessItem>();

    for (const item of items) {
      byText.set(item.text, item);
    }

    return [...byText.values()];
  };
  const renderReadinessItems = (items: ReadinessItem[], className: string, emptyText: string) =>
    items.length > 0
      ? items
          .map((item) => {
            const tooltip = item.detail ? ` data-tooltip="${escapeHtml(item.detail)}" tabindex="0"` : "";
            const ariaLabel = item.detail
              ? ` aria-label="${escapeHtml(`${item.text}. ${item.detail.replace(/\n/g, " ")}`)}"`
              : "";

            return `<li class="${className}${item.detail ? " has-tooltip" : ""}"${tooltip}${ariaLabel}>${escapeHtml(item.text)}</li>`;
          })
          .join("")
      : `<li class="is-empty">${escapeHtml(emptyText)}</li>`;
  const renderWarningGroups = (items: ReadinessItem[]) => {
    if (items.length === 0) {
      return `<div class="readiness-warning-group"><ul class="readiness-checks"><li class="is-empty">No warnings flagged.</li></ul></div>`;
    }

    const groups = new Map<string, ReadinessItem[]>();

    for (const item of items) {
      const group = item.group ?? "Other";
      groups.set(group, [...(groups.get(group) ?? []), item]);
    }

    const groupOrder = ["Raid Size", "Status Conflicts", "Comp Minimums", "Raid Buffs", "Roster Status", "Bench Rules", "Other"];
    const sortedGroups = [...groups.entries()].sort(([first], [second]) => {
      const firstIndex = groupOrder.includes(first) ? groupOrder.indexOf(first) : groupOrder.indexOf("Other");
      const secondIndex = groupOrder.includes(second) ? groupOrder.indexOf(second) : groupOrder.indexOf("Other");

      return firstIndex - secondIndex || first.localeCompare(second, undefined, { sensitivity: "base" });
    });

    return sortedGroups
      .map(
        ([group, groupItems]) => `
          <div class="readiness-warning-group">
            <span class="readiness-group-label">${escapeHtml(group)}</span>
            <ul class="readiness-checks">
              ${renderReadinessItems(groupItems, "is-warning", "")}
            </ul>
          </div>
        `,
      )
      .join("");
  };
  const getReadiness = ({
    activeRoster,
    rules,
    benchPlayers,
    outPlayers,
    latePlayers,
    miaPlayers,
  }: {
    activeRoster: DashboardPlayer[];
    rules: BenchRules;
    benchPlayers: DashboardPlayer[];
    outPlayers: DashboardPlayer[];
    latePlayers: DashboardPlayer[];
    miaPlayers: DashboardPlayer[];
  }) => {
    const activeSlugs = new Set(activeRoster.map((player) => player.slug));
    const activeOnly = (players: DashboardPlayer[]) => players.filter((player) => activeSlugs.has(player.slug));
    const bench = activeOnly(benchPlayers);
    const out = activeOnly(outPlayers);
    const late = activeOnly(latePlayers);
    const mia = activeOnly(miaPlayers);
    const unavailablePlayers = uniquePlayers([...out, ...late, ...mia]);
    const unavailableSlugs = new Set(unavailablePlayers.map((player) => player.slug));
    const benchSlugs = new Set(bench.map((player) => player.slug));
    const unavailableOrBenchSlugs = new Set([...unavailableSlugs, ...benchSlugs]);
    const availableCount = activeRoster.length - unavailableSlugs.size;
    const raidReadyPlayers = activeRoster.filter((player) => !unavailableOrBenchSlugs.has(player.slug));
    const raidReadyCount = raidReadyPlayers.length;
    const checks: ReadinessItem[] = [];
    const warnings: ReadinessItem[] = [];
    const counts = getAvailableCounts(activeRoster, unavailableSlugs, benchSlugs);
    const buffCoverage = getRaidBuffCoverage(raidReadyPlayers);

    if (raidReadyCount < 25) {
      warnings.push(makeItem(`${raidReadyCount} / 25 raid-ready`, undefined, "Raid Size"));
    }

    if (mia.length > 0) {
      warnings.push(makeItem(`MIA: ${mia.map((player) => player.name).join(", ")}`, undefined, "Roster Status"));
    }

    const statusByPlayer = new Map<string, { player: DashboardPlayer; statuses: string[] }>();
    const addPlayerStatus = (status: string, players: DashboardPlayer[]) => {
      for (const player of players) {
        const existing = statusByPlayer.get(player.slug) ?? { player, statuses: [] };
        existing.statuses.push(status);
        statusByPlayer.set(player.slug, existing);
      }
    };

    addPlayerStatus("Bench", bench);
    addPlayerStatus("Out", out);
    addPlayerStatus("Late", late);
    addPlayerStatus("MIA", mia);

    for (const { player, statuses } of [...statusByPlayer.values()].sort((a, b) =>
      a.player.name.localeCompare(b.player.name, undefined, { sensitivity: "base" }),
    )) {
      const uniqueStatuses = [...new Set(statuses)];

      if (uniqueStatuses.length > 1) {
        warnings.push(makeItem(`${player.name} is marked ${formatStatusList(uniqueStatuses)}`, undefined, "Status Conflicts"));
      }
    }

    if (buffCoverage.missing.length > 0) {
      warnings.push(makeItem(`Missing: ${buffCoverage.missing.join(", ")}`, buffCoverage.detail, "Raid Buffs"));
    } else {
      checks.push(makeItem("Raid Buffs: All covered", buffCoverage.detail));
    }

    for (const playerSlug of rules.neverBenchPlayers ?? []) {
      if (benchSlugs.has(playerSlug)) {
        const playerName = activeRoster.find((player) => player.slug === playerSlug)?.name ?? playerSlug;
        warnings.push(makeItem(`Never-bench violation: ${playerName}`, undefined, "Bench Rules"));
      }
    }

    for (const [firstPlayer, secondPlayer] of rules.avoidBenchingTogether ?? []) {
      if (benchSlugs.has(firstPlayer) && benchSlugs.has(secondPlayer)) {
        const firstName = activeRoster.find((player) => player.slug === firstPlayer)?.name ?? firstPlayer;
        const secondName = activeRoster.find((player) => player.slug === secondPlayer)?.name ?? secondPlayer;
        warnings.push(makeItem(`Avoid-together violation: ${firstName} + ${secondName}`, undefined, "Bench Rules"));
      }
    }

    for (const [role, minimum] of Object.entries(rules.minimumAvailableByRole ?? {})) {
      const available = counts.byRole.get(normalizeKey(role)) ?? 0;

      if (available < minimum) {
        const roleLabel = normalizeKey(role) === "healer" ? "Healer" : role;
        warnings.push(makeItem(formatMinimumCheck(roleLabel, available, minimum), undefined, "Comp Minimums"));
      } else {
        checks.push(makeItem(formatRoleMinimum(role, available, minimum)));
      }
    }

    for (const [className, minimum] of Object.entries(rules.minimumAvailableByClass ?? {})) {
      const available = counts.byClass.get(normalizeKey(className)) ?? 0;

      if (available < minimum) {
        warnings.push(makeItem(formatMinimumCheck(className, available, minimum), undefined, "Comp Minimums"));
      } else {
        checks.push(makeItem(formatMinimumCheck(className, available, minimum)));
      }
    }

    const status = raidReadyCount < 25 ? "Short" : warnings.length > 0 ? "Needs Review" : "Ready";
    const detail =
      status === "Short"
        ? `${raidReadyCount} raid-ready`
        : status === "Needs Review"
          ? `${raidReadyCount} raid-ready, ${plural(warnings.length, "warning")}`
          : `${raidReadyCount} raid-ready`;

    return {
      status,
      detail,
      availableCount,
      raidReadyCount,
      checks: uniqueReadinessItems(checks),
      warnings: uniqueReadinessItems(warnings),
    };
  };

  document.querySelectorAll<HTMLElement>("[data-next-raid]").forEach((card) => {
    const dataNode = card.querySelector<HTMLScriptElement>("[data-next-raid-data]");
    const activeRosterNode = card.querySelector<HTMLScriptElement>("[data-active-roster-data]");
    const rulesNode = card.querySelector<HTMLScriptElement>("[data-bench-rules-data]");
    const dateNode = card.querySelector<HTMLElement>("[data-next-raid-date]");
    const availableCard = card.querySelector<HTMLElement>("[data-available-card]");
    const raidersCount = card.querySelector<HTMLElement>("[data-week-raiders-count]");
    const benchNode = card.querySelector<HTMLElement>("[data-week-bench]");
    const outNode = card.querySelector<HTMLElement>("[data-week-out]");
    const lateNode = card.querySelector<HTMLElement>("[data-week-late]");
    const benchCount = card.querySelector<HTMLElement>("[data-week-bench-count]");
    const outCount = card.querySelector<HTMLElement>("[data-week-out-count]");
    const lateCount = card.querySelector<HTMLElement>("[data-week-late-count]");
    const readinessPanel = card.querySelector<HTMLElement>("[data-readiness-panel]");
    const readinessStatus = card.querySelector<HTMLElement>("[data-readiness-status]");
    const readinessDetail = card.querySelector<HTMLElement>("[data-readiness-detail]");
    const readinessColumns = card.querySelector<HTMLElement>("[data-readiness-columns]");
    const readinessPassingColumn = card.querySelector<HTMLElement>("[data-readiness-passing-column]");
    const readinessWarningCount = card.querySelector<HTMLElement>("[data-readiness-warning-count]");
    const readinessPassing = card.querySelector<HTMLElement>("[data-readiness-passing]");
    const readinessWarnings = card.querySelector<HTMLElement>("[data-readiness-warnings]");
    const raids = JSON.parse(dataNode?.textContent ?? "[]") as Array<{
      label: string;
      isoDate: string;
      bench: DashboardPlayer[];
      out: DashboardPlayer[];
      late: DashboardPlayer[];
      mia: DashboardPlayer[];
    }>;
    const activeRoster = JSON.parse(activeRosterNode?.textContent ?? "[]") as DashboardPlayer[];
    const rules = JSON.parse(rulesNode?.textContent ?? "{}") as BenchRules;
    const today = toLocalDate(new Date());
    const datedRaids = raids.map((raid) => ({ ...raid, date: parseIsoDate(raid.isoDate) }));
    const nextRaid = datedRaids.find((raid) => raid.date >= today) ?? datedRaids[datedRaids.length - 1];

    if (!nextRaid) {
      return;
    }

    const currentWeekStart = getWeekStart(today);
    const currentWeekRaids = datedRaids.filter((raid) => getWeekStart(raid.date).getTime() === currentWeekStart.getTime());
    const hasCurrentOrUpcomingRaidThisWeek = currentWeekRaids.some((raid) => raid.date >= today);
    const targetWeekStart =
      hasCurrentOrUpcomingRaidThisWeek && (today.getDay() === 0 || today.getDay() === 1)
        ? currentWeekStart
        : getWeekStart(nextRaid.date);
    const weekRaids = datedRaids.filter((raid) => getWeekStart(raid.date).getTime() === targetWeekStart.getTime()).slice(0, 2);
    const weekBench = uniquePlayers(weekRaids.flatMap((raid) => raid.bench));
    const weekOut = uniquePlayers(weekRaids.flatMap((raid) => raid.out));
    const weekLate = uniquePlayers(weekRaids.flatMap((raid) => raid.late));
    const weekMia = uniquePlayers(weekRaids.flatMap((raid) => raid.mia));
    const readiness = getReadiness({
      activeRoster,
      rules,
      benchPlayers: weekBench,
      outPlayers: weekOut,
      latePlayers: weekLate,
      miaPlayers: weekMia,
    });
    const raidDate = nextRaid.date;
    const weekday = new Intl.DateTimeFormat(undefined, { weekday: "long" }).format(raidDate);
    const month = new Intl.DateTimeFormat(undefined, { month: "short" }).format(raidDate);

    if (dateNode) {
      dateNode.textContent = `${weekday}, ${month} ${ordinal(raidDate.getDate())}`;
    }

    if (benchNode) {
      benchNode.innerHTML = playerListHtml(weekBench);
    }

    if (outNode) {
      outNode.innerHTML = playerListHtml(weekOut);
    }

    if (lateNode) {
      lateNode.innerHTML = playerListHtml(weekLate);
    }

    if (benchCount) {
      benchCount.textContent = String(weekBench.length);
    }

    if (outCount) {
      outCount.textContent = String(weekOut.length);
    }

    if (lateCount) {
      lateCount.textContent = String(weekLate.length);
    }

    if (raidersCount) {
      raidersCount.textContent = String(Math.max(readiness.availableCount, 0));
    }

    if (availableCard) {
      if (readiness.availableCount < 25) {
        availableCard.dataset.status = "short";
      } else {
        delete availableCard.dataset.status;
      }
    }

    if (readinessStatus) {
      readinessStatus.textContent = readiness.status;
    }

    if (readinessDetail) {
      readinessDetail.textContent = readiness.detail;
    }

    if (readinessPanel) {
      readinessPanel.dataset.status = readiness.status.toLocaleLowerCase().replace(/[^a-z0-9]+/g, "-");
    }

    if (readinessPassing) {
      const checks = readiness.checks;
      readinessPassing.innerHTML = renderReadinessItems(checks, "is-ok", "No rule checks configured.");

      if (readinessPassingColumn && readinessColumns) {
        readinessPassingColumn.hidden = checks.length === 0;
        readinessColumns.dataset.layout = checks.length === 0 ? "warnings-only" : "split";
      }
    }

    if (readinessWarningCount) {
      readinessWarningCount.textContent = plural(readiness.warnings.length, "warning");
    }

    if (readinessWarnings) {
      const warnings = readiness.warnings;
      readinessWarnings.innerHTML = renderWarningGroups(warnings);
    }
  });
</script>
