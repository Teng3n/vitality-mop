---
import Layout from "../../layouts/Layout.astro";
import DataTable from "../../components/DataTable.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatCard from "../../components/StatCard.astro";
import lootSummary from "../../data/lootSummary.json";
import roster from "../../data/roster.json";

const activeRoster = new Set(roster.map((row) => row.character.toLocaleLowerCase()));
const rows = [...lootSummary]
  .map((row) => ({
    ...row,
    activeRoster: activeRoster.has(row.player.toLocaleLowerCase()),
  }))
  .sort((a, b) => a.player.localeCompare(b.player, undefined, { sensitivity: "base" }));
const activeRows = rows.filter((row) => row.activeRoster);
const activeLoot = activeRows.reduce((sum, row) => sum + row.total, 0);
const columns = [
  { key: "player", label: "Player", sortable: true, sortType: "text" },
  { key: "bis", label: "BiS", align: "right", sortable: true, sortType: "number" },
  { key: "major", label: "Major", align: "right", sortable: true, sortType: "number" },
  { key: "minor", label: "Minor", align: "right", sortable: true, sortType: "number" },
  { key: "offspec", label: "Offspec", align: "right", sortable: true, sortType: "number" },
  { key: "bonusRolls", label: "Bonus Rolls", align: "right", sortable: true, sortType: "number" },
  { key: "total", label: "Total", align: "right", sortable: true, sortType: "number" },
] satisfies Array<{ key: string; label: string; align?: "left" | "center" | "right"; sortable?: boolean; sortType?: "text" | "number" }>;
---

<Layout title="Loot Summary | Vitality">
  <PageHeader
    eyebrow="Loot"
    title="Player Loot Summary"
  />

  <section class="dashboard-grid compact">
    <StatCard label="Active recipients" value={activeRows.length} detail="Shown by default" />
    <StatCard label="Active awards" value={activeLoot} detail="BiS, major, and minor" />
    <StatCard label="History" value="View" detail="Award log" href="/loot/history" />
  </section>

  <section class="panel">
    <div class="toolbar">
      <label class="check-field">
        <input type="checkbox" data-include-all-loot />
        <span>Include all loot recipients</span>
      </label>
      <span class="muted" data-loot-summary-count>{activeRows.length} players</span>
    </div>
    <DataTable
      columns={columns}
      rows={rows}
      initialSortKey="player"
      initialSortDirection="ascending"
      tableClass="loot-summary-table"
    />
  </section>

  <script>
    const includeAllLoot = document.querySelector<HTMLInputElement>("[data-include-all-loot]");
    const visibleCount = document.querySelector<HTMLElement>("[data-loot-summary-count]");
    const lootRows = Array.from(document.querySelectorAll<HTMLTableRowElement>(".loot-summary-table tbody tr"));

    const updateLootRows = () => {
      const showAll = includeAllLoot?.checked ?? false;
      let count = 0;

      for (const row of lootRows) {
        const hidden = !showAll && row.dataset.activeRoster === "false";
        row.hidden = hidden;

        if (!hidden) {
          count += 1;
        }
      }

      if (visibleCount) {
        visibleCount.textContent = `${count} players`;
      }
    };

    includeAllLoot?.addEventListener("change", updateLootRows);
    updateLootRows();
  </script>
</Layout>
