---
import Layout from "../layouts/Layout.astro";
import StatCard from "../components/StatCard.astro";
import progressionSeed from "../data/wclProgressionSeed.json";

type DifficultyStatus = "Killed" | "Best Pull" | "No Data";
type ProgressionDifficulty = {
  status?: string | null;
  firstKillDate?: string | null;
  latestKillDate?: string | null;
  bestPercent?: number | null;
  reportCode?: string | null;
  reportUrl?: string | null;
  pulls?: number | null;
  kills?: number | null;
};
type ProgressionBoss = {
  name?: string | null;
  encounterId?: number | null;
  difficulties?: Record<string, ProgressionDifficulty | undefined> | null;
};
type ProgressionRaid = {
  name?: string | null;
  zoneId?: number | null;
  bosses?: ProgressionBoss[] | null;
  summary?: {
    normalKilled?: number | null;
    normalTotal?: number | null;
    heroicKilled?: number | null;
    heroicTotal?: number | null;
  } | null;
};
type ProgressionSeed = {
  guild?: {
    name?: string | null;
    server?: string | null;
    serverSlug?: string | null;
    region?: string | null;
  } | null;
  raids?: ProgressionRaid[] | null;
};
type KillRecord = {
  raidName: string;
  bossName: string;
  difficultyName: string;
  date: string;
};

const seed = progressionSeed as ProgressionSeed;
const raids = Array.isArray(seed.raids) ? seed.raids : [];

const formatDate = (value?: string | null) => {
  if (!value) {
    return "";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
};
const formatPercent = (value?: number | null) => {
  if (typeof value !== "number" || !Number.isFinite(value)) {
    return "";
  }

  return `${Number.isInteger(value) ? value : value.toFixed(1)}%`;
};
const getDifficulty = (boss: ProgressionBoss, difficultyName: string): ProgressionDifficulty | undefined =>
  boss.difficulties?.[difficultyName];
const getDifficultyStatus = (difficulty?: ProgressionDifficulty): DifficultyStatus => {
  if (!difficulty) {
    return "No Data";
  }

  const status = String(difficulty.status ?? "").trim().toLowerCase();

  if (status === "killed") {
    return "Killed";
  }

  if (status === "best pull") {
    return "Best Pull";
  }

  return "No Data";
};
const isDifficultyKilled = (difficulty?: ProgressionDifficulty) => getDifficultyStatus(difficulty) === "Killed";
const normalizeBossName = (value?: string | null) =>
  String(value ?? "")
    .toLowerCase()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "")
    .trim();
const throneOfThunderEncounterOrder = new Map<number, number>([
  [51577, 1],
  [51575, 2],
  [51570, 3],
  [51565, 4],
  [51578, 5],
  [51573, 6],
  [51572, 7],
  [51574, 8],
  [51576, 9],
  [51559, 10],
  [51560, 11],
  [51579, 12],
  [51580, 13],
]);
const throneOfThunderNameOrder = new Map<string, number>([
  ["jinrokhthebreaker", 1],
  ["horridon", 2],
  ["councilofelders", 3],
  ["tortos", 4],
  ["megaera", 5],
  ["jikun", 6],
  ["durumutheforgotten", 7],
  ["primordius", 8],
  ["darkanimus", 9],
  ["ironqon", 10],
  ["twinconsorts", 11],
  ["twinempyreans", 11],
  ["leishen", 12],
  ["raden", 13],
]);
const getBossSortOrder = (raid: ProgressionRaid, boss: ProgressionBoss) => {
  if (normalizeBossName(raid.name) !== "throneofthunder") {
    return Number.POSITIVE_INFINITY;
  }

  if (typeof boss.encounterId === "number" && throneOfThunderEncounterOrder.has(boss.encounterId)) {
    return throneOfThunderEncounterOrder.get(boss.encounterId) ?? Number.POSITIVE_INFINITY;
  }

  return throneOfThunderNameOrder.get(normalizeBossName(boss.name)) ?? Number.POSITIVE_INFINITY;
};
const getSortedBosses = (raid: ProgressionRaid) =>
  [...(raid.bosses ?? [])].sort(
    (a, b) =>
      getBossSortOrder(raid, a) - getBossSortOrder(raid, b) ||
      (a.encounterId ?? Number.POSITIVE_INFINITY) - (b.encounterId ?? Number.POSITIVE_INFINITY) ||
      (a.name || "").localeCompare(b.name || ""),
  );
const getRaidEffectiveProgress = (raid: ProgressionRaid) => {
  const bosses = Array.isArray(raid.bosses) ? raid.bosses : [];
  const totalBosses = bosses.length;
  const heroicKilledCount = bosses.filter((boss) => isDifficultyKilled(getDifficulty(boss, "Heroic"))).length;
  const normalOnlyKilledCount = bosses.filter(
    (boss) => isDifficultyKilled(getDifficulty(boss, "Normal")) && !isDifficultyKilled(getDifficulty(boss, "Heroic")),
  ).length;

  return {
    heroicKilledCount,
    normalOnlyKilledCount,
    totalBosses,
    effectiveKilledCount: heroicKilledCount + normalOnlyKilledCount,
  };
};
const getAggregateEffectiveProgress = () =>
  raids.reduce(
    (total, raid) => {
      const progress = getRaidEffectiveProgress(raid);
      return {
        heroicKilledCount: total.heroicKilledCount + progress.heroicKilledCount,
        normalOnlyKilledCount: total.normalOnlyKilledCount + progress.normalOnlyKilledCount,
        totalBosses: total.totalBosses + progress.totalBosses,
        effectiveKilledCount: total.effectiveKilledCount + progress.effectiveKilledCount,
      };
    },
    { heroicKilledCount: 0, normalOnlyKilledCount: 0, totalBosses: 0, effectiveKilledCount: 0 },
  );
const getDifficultyKillDate = (difficulty?: ProgressionDifficulty) => difficulty?.latestKillDate || difficulty?.firstKillDate || "";
const getLatestKills = (sourceRaids: ProgressionRaid[]) => {
  const kills: KillRecord[] = [];

  for (const raid of sourceRaids) {
    const raidName = raid.name || "Unknown Raid";

    for (const boss of raid.bosses ?? []) {
      const bossName = boss.name || "Unknown Boss";

      for (const [difficultyName, difficulty] of Object.entries(boss.difficulties ?? {})) {
        if (getDifficultyStatus(difficulty) !== "Killed") {
          continue;
        }

        const date = getDifficultyKillDate(difficulty);

        if (date) {
          kills.push({ raidName, bossName, difficultyName, date });
        }
      }
    }
  }

  return kills.sort((a, b) => b.date.localeCompare(a.date));
};
const getRaidLatestKill = (raid: ProgressionRaid) => getLatestKills([raid])[0];
const aggregateProgress = getAggregateEffectiveProgress();
const latestKill = getLatestKills(raids)[0];
const currentTier =
  raids.length === 0 ? "No data" : raids.length === 1 ? raids[0]?.name || "Unknown Raid" : `${raids.length} raids`;
const hasProgressionData = raids.some((raid) => Array.isArray(raid.bosses) && raid.bosses.length > 0);
const getStatusClass = (status: DifficultyStatus) =>
  status === "Killed" ? "is-killed" : status === "Best Pull" ? "is-best-pull" : "is-no-data";
const getDifficultyMeta = (difficulty?: ProgressionDifficulty) => {
  const status = getDifficultyStatus(difficulty);
  const firstKillDate = formatDate(difficulty?.firstKillDate);
  const latestKillDate = formatDate(difficulty?.latestKillDate);
  const bestPercent = status === "Best Pull" ? formatPercent(difficulty?.bestPercent) : "";

  return {
    status,
    firstKillDate,
    latestKillDate,
    bestPercent,
    reportUrl: difficulty?.reportUrl || "",
  };
};
const getBossDifficultyRows = (boss: ProgressionBoss) => {
  const normalMeta = getDifficultyMeta(getDifficulty(boss, "Normal"));
  const heroicMeta = getDifficultyMeta(getDifficulty(boss, "Heroic"));

  if (heroicMeta.status === "Killed") {
    return [{ name: "Heroic", meta: heroicMeta }];
  }

  if (normalMeta.status === "Killed") {
    return [
      { name: "Normal", meta: normalMeta },
      { name: "Heroic", meta: heroicMeta },
    ];
  }

  const normalScore = normalMeta.status === "Best Pull" ? 1 : 0;
  const heroicScore = heroicMeta.status === "Best Pull" ? 1 : 0;

  return heroicScore > normalScore
    ? [
        { name: "Heroic", meta: heroicMeta },
        { name: "Normal", meta: normalMeta },
      ]
    : [
        { name: "Normal", meta: normalMeta },
        { name: "Heroic", meta: heroicMeta },
      ];
};
---

<Layout title="Progression | Vitality">
  <section class="page-header progression-header">
    <p class="eyebrow">Progression</p>
  </section>

  <section class="dashboard-grid progression-summary-grid">
    <StatCard label="Current Tier" value={currentTier} />
    <StatCard
      label="Heroic Progress"
      value={`${aggregateProgress.heroicKilledCount} / ${aggregateProgress.totalBosses}`}
      detail="bosses killed"
    />
    <StatCard
      label="Normal Only"
      value={`${aggregateProgress.normalOnlyKilledCount} / ${aggregateProgress.totalBosses}`}
      detail="bosses killed"
    />
    <StatCard
      label="Latest Kill"
      value={latestKill?.bossName ?? "None"}
      detail={latestKill ? `${latestKill.difficultyName} - ${formatDate(latestKill.date)}` : "No kills synced"}
    />
  </section>

  {
    hasProgressionData ? (
      <section class="progression-raid-stack">
        {raids.map((raid) => {
          const progress = getRaidEffectiveProgress(raid);
          const raidLatestKill = getRaidLatestKill(raid);

          return (
            <section class="panel progression-raid-panel">
              <div class="section-heading inline">
                <div>
                  <p class="eyebrow">Raid</p>
                  <h2>{raid.name || "Unknown Raid"}</h2>
                  <p class="info-note">
                    {`Heroic ${progress.heroicKilledCount} / ${progress.totalBosses}, Normal Only ${progress.normalOnlyKilledCount} / ${progress.totalBosses}`}
                  </p>
                </div>
                <div class="progression-raid-latest">
                  <span>Latest Kill</span>
                  <strong>{raidLatestKill?.bossName ?? "None"}</strong>
                  {raidLatestKill && <small>{raidLatestKill.difficultyName} - {formatDate(raidLatestKill.date)}</small>}
                </div>
              </div>

              <div class="progression-boss-grid">
                {getSortedBosses(raid).map((boss) => {
                  const difficultyRows = getBossDifficultyRows(boss);

                  return (
                    <article class="progression-boss-card">
                      <h3>{boss.name || "Unknown Boss"}</h3>
                      {difficultyRows.map(({ name: difficultyName, meta }) => (
                        <section class="progression-difficulty">
                          <div class="progression-difficulty-head">
                            <span>{difficultyName}</span>
                            <strong class={`progression-status ${getStatusClass(meta.status)}`}>{meta.status}</strong>
                          </div>

                          <dl class="progression-detail-list">
                            {meta.firstKillDate && (
                              <div>
                                <dt>First kill</dt>
                                <dd>{meta.firstKillDate}</dd>
                              </div>
                            )}
                            {meta.latestKillDate && (
                              <div>
                                <dt>Latest kill</dt>
                                <dd>{meta.latestKillDate}</dd>
                              </div>
                            )}
                            {meta.bestPercent && (
                              <div>
                                <dt>Best pull</dt>
                                <dd>{meta.bestPercent}</dd>
                              </div>
                            )}
                          </dl>

                          {meta.reportUrl && (
                            <a class="progression-log-link" href={meta.reportUrl} target="_blank" rel="noreferrer">
                              View Log
                            </a>
                          )}
                        </section>
                      ))}
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </section>
    ) : (
      <section class="panel progression-empty-panel">
        <p class="eyebrow">Warcraft Logs</p>
        <h2>No Warcraft Logs progression data has been synced yet.</h2>
        <p class="info-note">Once the sync imports guild reports, raid and boss progression will appear here.</p>
      </section>
    )
  }
</Layout>
