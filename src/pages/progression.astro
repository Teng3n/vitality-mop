---
import Layout from "../layouts/Layout.astro";
import progressionSeed from "../data/wclProgressionSeed.json";
import {
  getProgressBreakdown,
  getTierLatestKill,
  getTierProgress,
  progressionExpansions,
  type ProgressionSeed,
} from "../lib/progressionTiers";

const seed = progressionSeed as ProgressionSeed;
const raids = Array.isArray(seed.raids) ? seed.raids : [];

const formatDate = (value?: string | null) => {
  if (!value) {
    return "";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};

const expansionSummaries = progressionExpansions.map((expansion) => ({
  expansion,
  tiers: expansion.tiers.map((tier) => {
    const progress = getTierProgress(tier, raids);
    const tierLatestKill = getTierLatestKill(tier, raids);

    return {
      tier,
      progress,
      latestKill: tierLatestKill,
    };
  }),
}));
---

<Layout title="Progression | Vitality">
  <section class="page-header progression-header">
    <p class="eyebrow">Progression</p>
  </section>

  <div class="progression-expansion-stack">
    {expansionSummaries.map(({ expansion, tiers }) => (
      <section class={`panel progression-expansion-panel ${expansion.isPlaceholder ? "is-placeholder" : ""}`}>
        <div class="progression-expansion-header">
          <div>
            <p class="eyebrow">{expansion.shortName}</p>
            <h2>{expansion.name}</h2>
          </div>
          {expansion.isPlaceholder && <span>Coming soon</span>}
        </div>

        <div class="progression-tier-grid">
          {tiers.map(({ tier, progress, latestKill: tierLatestKill }) => {
            const hasData = progress.totalBosses > 0;
            const isComplete = hasData && progress.killedBosses === progress.totalBosses;
            const completionLabel = progress.killedBosses > 0 && !isComplete ? "Progressed To" : "Completed";
            const completionValue = tierLatestKill
              ? `${tierLatestKill.bossName} ${tierLatestKill.difficultyName}`
              : "Not started";
            const href = tier.isPlaceholder ? "" : `/progression/${expansion.slug}/${tier.slug}`;
            const raidNames = tier.raidNames.join(", ");
            const cardClass = `progression-tier-card ${tier.isPlaceholder ? "is-placeholder" : ""}`;
            const cardContent = (
              <>
                <div class="progression-tier-card-head">
                  <p class="eyebrow">{tier.name}</p>
                  <p class="progression-tier-raids" title={raidNames}>{raidNames}</p>
                </div>

                <div class="progression-tier-progress">
                  <h3>{tier.isPlaceholder ? "Coming soon" : hasData ? `${progress.killedBosses} / ${progress.totalBosses}` : "No data"}</h3>
                  {!tier.isPlaceholder && hasData && <small>{getProgressBreakdown(progress)}</small>}
                </div>

                <div class="progression-tier-meta">
                  {tier.isPlaceholder ? (
                    <>
                      <span>Status</span>
                      <strong>No data yet</strong>
                    </>
                  ) : (
                    <>
                      <span>{completionLabel}</span>
                      <strong>{completionValue}</strong>
                      {tierLatestKill && <small>{formatDate(tierLatestKill.date)}</small>}
                    </>
                  )}
                </div>

                <span class="progression-tier-link">{tier.isPlaceholder ? "Coming soon" : "View tier"}</span>
              </>
            );

            return href ? (
              <a class={cardClass} href={href}>
                {cardContent}
              </a>
            ) : (
              <article class={cardClass}>
                {cardContent}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>
