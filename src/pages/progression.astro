---
import Layout from "../layouts/Layout.astro";
import progressionSeed from "../data/wclProgressionSeed.json";
import {
  getProgressBreakdown,
  getTierLatestKill,
  getTierProgress,
  progressionTiers,
  type ProgressionSeed,
} from "../lib/progressionTiers";

const seed = progressionSeed as ProgressionSeed;
const raids = Array.isArray(seed.raids) ? seed.raids : [];

const formatDate = (value?: string | null) => {
  if (!value) {
    return "";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};

const getTierSortNumber = (slug: string) => Number(slug.replace("tier-", "")) || 0;

const tierSummaries = [...progressionTiers]
  .sort((a, b) => getTierSortNumber(b.slug) - getTierSortNumber(a.slug))
  .map((tier) => {
    const progress = getTierProgress(tier, raids);
    const tierLatestKill = getTierLatestKill(tier, raids);

    return {
      tier,
      progress,
      latestKill: tierLatestKill,
    };
  });
---

<Layout title="Progression | Vitality">
  <section class="page-header progression-header">
    <p class="eyebrow">Progression</p>
  </section>

  <section class="progression-tier-stack">
    <div class="section-heading">
      <p class="eyebrow">Tier History</p>
      <h2>MoP Raid Tiers</h2>
    </div>

    <div class="progression-tier-grid">
      {tierSummaries.map(({ tier, progress, latestKill: tierLatestKill }) => {
        const hasData = progress.totalBosses > 0;
        const isComplete = hasData && progress.killedBosses === progress.totalBosses;
        const completionLabel = progress.killedBosses > 0 && !isComplete ? "Progressed To" : "Completed";
        const completionValue = tierLatestKill
          ? `${tierLatestKill.bossName} ${tierLatestKill.difficultyName}`
          : "Not started";
        const raidNames = tier.raidNames.join(", ");

        return (
          <a class="progression-tier-card" href={`/progression/${tier.slug}`}>
            <div class="progression-tier-card-head">
              <p class="eyebrow">{tier.name}</p>
              <p class="progression-tier-raids" title={raidNames}>{raidNames}</p>
            </div>

            <div class="progression-tier-progress">
              <h3>
                {
                  hasData ? (
                    `${progress.killedBosses} / ${progress.totalBosses}`
                  ) : (
                    "No data"
                  )
                }
              </h3>
              {hasData && <small>{getProgressBreakdown(progress)}</small>}
            </div>

            <div class="progression-tier-meta">
              <span>{completionLabel}</span>
              <strong>{completionValue}</strong>
              {tierLatestKill && <small>{formatDate(tierLatestKill.date)}</small>}
            </div>

            <span class="progression-tier-link">View tier</span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
