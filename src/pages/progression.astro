---
import Layout from "../layouts/Layout.astro";
import StatCard from "../components/StatCard.astro";
import progressionSeed from "../data/wclProgressionSeed.json";
import {
  getBestDifficultyLabel,
  getCurrentRaid,
  getCurrentTier,
  getCurrentTierProgress,
  getLatestKills,
  getProgressBreakdown,
  getTierLatestKill,
  getTierProgress,
  getTierRaids,
  progressionTiers,
  type ProgressionSeed,
} from "../lib/progressionTiers";

const seed = progressionSeed as ProgressionSeed;
const raids = Array.isArray(seed.raids) ? seed.raids : [];

const formatDate = (value?: string | null) => {
  if (!value) {
    return "";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
};

const latestKill = getLatestKills(raids)[0];
const currentRaid = getCurrentRaid(raids);
const currentTier = getCurrentTier(raids);
const currentTierProgress = getCurrentTierProgress(raids);
const tierSummaries = progressionTiers.map((tier) => {
  const tierRaids = getTierRaids(tier, raids);
  const progress = getTierProgress(tier, raids);
  const tierLatestKill = getTierLatestKill(tier, raids);

  return {
    tier,
    tierRaids,
    progress,
    latestKill: tierLatestKill,
  };
});
---

<Layout title="Progression | Vitality">
  <section class="page-header progression-header">
    <p class="eyebrow">Progression</p>
  </section>

  <section class="dashboard-grid progression-summary-grid">
    <StatCard label="Current Tier" value={currentTier?.name || "No data"} />
    <StatCard label="Current Raid" value={currentRaid?.name || "No data"} />
    <StatCard
      label="Progress"
      value={currentTierProgress.totalBosses > 0 ? `${currentTierProgress.killedBosses} / ${currentTierProgress.totalBosses}` : "No data"}
      detail={getProgressBreakdown(currentTierProgress)}
    />
    <StatCard
      label="Latest Kill"
      value={latestKill?.bossName ?? "None"}
      detail={latestKill ? `${latestKill.difficultyName} - ${formatDate(latestKill.date)}` : "No kills synced"}
    />
  </section>

  <section class="progression-tier-stack">
    <div class="section-heading">
      <p class="eyebrow">Tier History</p>
      <h2>MoP Raid Tiers</h2>
    </div>

    <div class="progression-tier-grid">
      {tierSummaries.map(({ tier, tierRaids, progress, latestKill: tierLatestKill }) => {
        const hasData = progress.totalBosses > 0;

        return (
          <a class="progression-tier-card" href={`/progression/${tier.slug}`}>
            <div class="progression-tier-card-head">
              <p class="eyebrow">{tier.name}</p>
              <h3>{hasData ? `${progress.killedBosses} / ${progress.totalBosses}` : "Not started"}</h3>
              <small>{hasData ? getProgressBreakdown(progress) : "No synced data"}</small>
            </div>

            <p class="progression-tier-raids">{tier.raidNames.join(", ")}</p>

            <div class="progression-tier-meta">
              <span>Best Difficulty</span>
              <strong>{getBestDifficultyLabel(progress)}</strong>
            </div>

            <div class="progression-tier-meta">
              <span>Latest Kill</span>
              <strong>{tierLatestKill?.bossName ?? "None"}</strong>
              {tierLatestKill && <small>{tierLatestKill.difficultyName} - {formatDate(tierLatestKill.date)}</small>}
            </div>

            <span class="progression-tier-link">{tierRaids.length > 0 ? "View tier" : "View empty tier"}</span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
