---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Officer Roster | Vitality">
  <OfficerGate>
    <section data-officer-roster-root></section>
  </OfficerGate>
</Layout>

<script>
  interface OfficerRosterRow {
    player: string;
    href: string;
    class: string;
    classColor: string;
    spec: string;
    role: string;
    bench: number;
    out: number;
    late: number;
    mia: number;
  }

  interface OfficerRosterResponse {
    ok?: boolean;
    message?: string;
    totals?: {
      roster: number;
      bench: number;
      out: number;
      late: number;
      mia: number;
    };
    rows?: OfficerRosterRow[];
  }

  const rosterRoot = document.querySelector<HTMLElement>("[data-officer-roster-root]");
  let rosterRendered = false;

  const escapeHtml = (value: string | number) =>
    String(value).replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[character] ?? character;
    });

  const parseJsonResponse = async <T,>(response: Response): Promise<T | undefined> => {
    const responseText = await response.text();

    if (!responseText) {
      return undefined;
    }

    try {
      return JSON.parse(responseText) as T;
    } catch {
      return undefined;
    }
  };

  const renderRoster = (data: OfficerRosterResponse) => {
    if (!rosterRoot || !data.totals || !data.rows) {
      return;
    }

    const rows = data.rows
      .map(
        (row) => `
          <tr style="--class-color: ${escapeHtml(row.classColor)}">
            <td data-label="Player">
              <a class="player-name" href="${escapeHtml(row.href)}" style="--player-color: ${escapeHtml(row.classColor)}" title="${escapeHtml(row.class)}">
                ${escapeHtml(row.player)}
              </a>
            </td>
            <td data-label="Class">${escapeHtml(row.class)}</td>
            <td data-label="Spec">${escapeHtml(row.spec)}</td>
            <td data-label="Role">${escapeHtml(row.role)}</td>
            <td class="is-right" data-label="Bench">${row.bench}</td>
            <td class="is-right" data-label="Out">${row.out}</td>
            <td class="is-right" data-label="Late">${row.late}</td>
            <td class="is-right" data-label="MIA">${row.mia}</td>
          </tr>
        `,
      )
      .join("");

    rosterRoot.innerHTML = `
      <section class="page-header">
        <p class="eyebrow">Roster</p>
        <h1 class="sr-only">Raid Team</h1>
      </section>

      <section class="dashboard-grid roster-summary-grid">
        <article class="stat-card"><span>Roster Count</span><strong>${data.totals.roster}</strong></article>
        <article class="stat-card"><span>Total Bench</span><strong>${data.totals.bench}</strong></article>
        <article class="stat-card"><span>Total Out</span><strong>${data.totals.out}</strong></article>
        <article class="stat-card"><span>Total Late</span><strong>${data.totals.late}</strong></article>
        <article class="stat-card"><span>Total MIA</span><strong>${data.totals.mia}</strong></article>
      </section>

      <section class="panel">
        <div class="table-shell">
          <table class="data-table roster-table officer-roster-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>Class</th>
                <th>Spec</th>
                <th>Role</th>
                <th class="is-right">Bench</th>
                <th class="is-right">Out</th>
                <th class="is-right">Late</th>
                <th class="is-right">MIA</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      </section>
    `;
  };

  const loadOfficerRoster = async () => {
    if (!rosterRoot || rosterRendered) {
      return;
    }

    rosterRendered = true;
    rosterRoot.innerHTML = `<section class="panel officer-note-panel"><p class="info-note">Loading officer roster...</p></section>`;

    try {
      const response = await fetch("/api/officer-roster");
      const result = await parseJsonResponse<OfficerRosterResponse>(response);

      if (!response.ok || result?.ok !== true) {
        throw new Error(result?.message ?? "Unable to load officer roster.");
      }

      renderRoster(result);
    } catch {
      rosterRoot.innerHTML = `<section class="panel officer-note-panel"><p class="info-note">Unable to load officer roster.</p></section>`;
    }
  };

  window.addEventListener("vitality:officer-unlocked", loadOfficerRoster);
  window.addEventListener("vitality:officer-locked", () => {
    rosterRendered = false;

    if (rosterRoot) {
      rosterRoot.innerHTML = "";
    }
  });
</script>
