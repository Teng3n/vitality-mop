---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";

const officerTools = [
  {
    eyebrow: "Data",
    title: "Sync",
    description: "Refresh guild data from Google Sheets and Warcraft Logs.",
    href: "/officer/sync",
    action: "Open Sync",
  },
  {
    eyebrow: "Roster",
    title: "Officer Roster",
    description: "Review roster status, loot totals, and attendance signals.",
    href: "/officer/roster",
    action: "Open Roster",
  },
  {
    eyebrow: "Progression",
    title: "Prog Bench",
    description: "Generate boss-by-boss progression bench suggestions.",
    href: "/officer/boss-bench-suggestions",
    action: "Open Prog Bench",
  },
  {
    eyebrow: "Farm",
    title: "Farm Bench",
    description: "Generate weekly farm bench suggestions.",
    href: "/officer/farm-bench-suggestions",
    action: "Open Farm Bench",
  },
];
---

<Layout title="Officer | Vitality">
  <OfficerGate>
    <section class="page-header officer-client-heading">
      <p class="eyebrow">Officer</p>
      <h1>Officer Tools</h1>
      <p>Private planning tools for roster data, syncing, and bench suggestions.</p>
    </section>

    <section class="officer-tools-panel-group" aria-label="Officer tools">
      <div class="officer-tools-grid">
        {
          officerTools.map((tool) => (
            <article class="panel officer-tool-card">
              <div class="section-heading">
                <p class="eyebrow">{tool.eyebrow}</p>
                <h2>{tool.title}</h2>
                <p class="info-note">{tool.description}</p>
              </div>

              <div class="officer-tool-actions">
                <a class="filter-button is-subtle" href={tool.href}>
                  {tool.action}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </OfficerGate>
</Layout>
