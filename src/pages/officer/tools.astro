---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Officer Tools | Vitality">
  <OfficerGate>
    <section data-officer-tools-root></section>
  </OfficerGate>
</Layout>

<script>
  const toolsRoot = document.querySelector<HTMLElement>("[data-officer-tools-root]");
  let toolsRendered = false;

  const parseJsonResponse = async <T,>(response: Response): Promise<T | undefined> => {
    const responseText = await response.text();

    if (!responseText) {
      return undefined;
    }

    try {
      return JSON.parse(responseText) as T;
    } catch {
      return undefined;
    }
  };

  interface GearNeedTarget {
    item: string;
    slot: string;
    category: string;
    importance: string;
    reason: string;
  }

  interface PlayerGearNeed {
    slug: string;
    name: string;
    className: string;
    spec: string;
    role: string;
    warcraftLogsUrl: string;
    needs: GearNeedTarget[];
    acquired: {
      item: string;
      date: string;
      boss: string;
      responseType: string;
    }[];
    status: "needs" | "complete" | "no-tracked-need";
    statusLabel: string;
    targetCount: number;
  }

  interface GearNeedsReport {
    scope: string;
    notes: string[];
    summary: {
      activeRosterCount: number;
      bossCount: number;
      targetCount: number;
      lootAwardsConsidered: number;
      playersWithOpenNeeds: number;
      warcraftLogsBaseline: string;
    };
    bosses: {
      bossName: string;
      order: number;
      players: PlayerGearNeed[];
      stillNeeds: PlayerGearNeed[];
      acquired: PlayerGearNeed[];
      targetCount: number;
      stillNeedsCount: number;
      safeCount: number;
    }[];
  }

  const escapeHtml = (value: string | number) =>
    String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const renderOfficerTools = () => {
    if (!toolsRoot || toolsRendered) {
      return;
    }

    toolsRendered = true;
    toolsRoot.innerHTML = `
      <section class="page-header officer-client-heading">
        <p class="eyebrow">Officer</p>
        <h1>Officer Tools</h1>
        <p>Officer utilities for data sync and bench planning.</p>
      </section>

      <section class="officer-tools-panel-group" data-bench-suggestion-tool>
        <div class="officer-tools-grid">
          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Sync Guild Data</p>
              <p class="info-note">
                Refresh roster, calendar, bench, and loot from Google Sheets.
              </p>
            </div>

            <div class="officer-tool-actions">
              <div class="sync-trigger" data-sync-control>
                <button class="sync-trigger-button" type="button" data-sync-trigger data-sync-type="sheets">Sync Guild Data</button>
                <span class="sync-trigger-status" data-sync-trigger-status aria-live="polite"></span>
              </div>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Warcraft Logs</p>
              <p class="info-note">
                Refresh progression data from Warcraft Logs.
              </p>
            </div>

            <div class="officer-tool-actions">
              <div class="sync-trigger" data-sync-control>
                <button class="sync-trigger-button" type="button" data-sync-trigger data-sync-type="wcl">Sync Warcraft Logs</button>
                <span class="sync-trigger-status" data-sync-trigger-status aria-live="polite"></span>
              </div>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Bench Suggestions</p>
              <p class="info-note">
                Generate a draft bench plan from the current roster, calendar statuses, and Bench Rules.
              </p>
            </div>

            <div class="officer-tool-actions">
              <button class="filter-button is-subtle" type="button" data-bench-suggestion-generate>
                Generate Bench Suggestions
              </button>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Gear Needs</p>
              <p class="info-note">
                Compare curated SoO boss drops against roster specs and the guild loot history.
              </p>
            </div>

            <div class="officer-tool-actions">
              <button class="filter-button is-subtle" type="button" data-gear-needs-load>
                Load Gear Needs
              </button>
            </div>
          </article>
        </div>

        <section class="panel bench-suggestion-output-panel" data-bench-suggestion-output hidden>
          <div class="section-heading inline bench-suggestion-heading">
            <div>
              <p class="eyebrow">Suggested Bench Plan</p>
            </div>
            <button class="filter-button is-subtle" type="button" data-bench-suggestion-copy>Copy</button>
          </div>

          <div class="bench-suggestion-output">
            <pre data-bench-suggestion-text></pre>
          </div>
          <p class="info-note bench-suggestion-status" data-bench-suggestion-status aria-live="polite"></p>
        </section>

        <section class="panel gear-needs-output-panel" data-gear-needs-output hidden>
          <div class="section-heading inline gear-needs-heading">
            <div>
              <p class="eyebrow">Boss Gear Needs</p>
            </div>
            <button class="filter-button is-subtle" type="button" data-gear-needs-copy>Copy</button>
          </div>

          <div data-gear-needs-content></div>
          <pre class="gear-needs-copy-source" data-gear-needs-text hidden></pre>
          <p class="info-note gear-needs-status" data-gear-needs-status aria-live="polite"></p>
        </section>
      </section>
    `;

    bindSyncControls();
    bindBenchSuggestionTool();
    bindGearNeedsTool();
  };

  const bindSyncControls = () => {
    const syncControls = toolsRoot?.querySelectorAll<HTMLElement>("[data-sync-control]") ?? [];

    syncControls.forEach((syncControl) => {
      const syncButton = syncControl.querySelector<HTMLButtonElement>("[data-sync-trigger]");
      const syncStatus = syncControl.querySelector<HTMLElement>("[data-sync-trigger-status]");
      const syncType = syncButton?.dataset.syncType ?? "sheets";
      const defaultButtonText = syncButton?.textContent ?? "Sync";
      let syncRequestInFlight = false;

      syncButton?.addEventListener("click", async () => {
        if (syncRequestInFlight) {
          return;
        }

        syncRequestInFlight = true;
        syncButton.disabled = true;
        syncButton.textContent = "Syncing...";

        if (syncStatus) {
          syncStatus.textContent = "";
          syncStatus.dataset.state = "";
        }

        try {
          const response = await fetch("/api/trigger-sync", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ syncType }),
          });
          const result = await parseJsonResponse<{ ok?: boolean; message?: string }>(response);
          const isSuccess = response.ok && result?.ok === true;
          const message = isSuccess
            ? (result?.message ?? "Sync workflow triggered.")
            : (result?.message ?? "Unable to trigger sync workflow.");

          if (syncStatus) {
            syncStatus.textContent = message;
            syncStatus.dataset.state = isSuccess ? "success" : "error";
          }
        } catch {
          if (syncStatus) {
            syncStatus.textContent = "Unable to trigger sync workflow.";
            syncStatus.dataset.state = "error";
          }
        } finally {
          syncRequestInFlight = false;
          syncButton.disabled = false;
          syncButton.textContent = defaultButtonText;
        }
      });
    });
  };

  const bindBenchSuggestionTool = () => {
    const benchSuggestionTool = toolsRoot?.querySelector<HTMLElement>("[data-bench-suggestion-tool]");
    const benchSuggestionGenerate = benchSuggestionTool?.querySelector<HTMLButtonElement>("[data-bench-suggestion-generate]");
    const benchSuggestionCopy = benchSuggestionTool?.querySelector<HTMLButtonElement>("[data-bench-suggestion-copy]");
    const benchSuggestionOutput = benchSuggestionTool?.querySelector<HTMLElement>("[data-bench-suggestion-output]");
    const benchSuggestionText = benchSuggestionTool?.querySelector<HTMLElement>("[data-bench-suggestion-text]");
    const benchSuggestionStatus = benchSuggestionTool?.querySelector<HTMLElement>("[data-bench-suggestion-status]");

    benchSuggestionGenerate?.addEventListener("click", async () => {
      if (!benchSuggestionOutput || !benchSuggestionText) {
        return;
      }

      benchSuggestionGenerate.disabled = true;
      benchSuggestionGenerate.textContent = "Generating...";

      if (benchSuggestionStatus) {
        benchSuggestionStatus.textContent = "";
      }

      try {
        const response = await fetch("/api/bench-suggestions");
        const result = await parseJsonResponse<{ ok?: boolean; text?: string; message?: string }>(response);

        if (!response.ok || result?.ok !== true || !result.text) {
          throw new Error(result?.message ?? "Unable to generate bench suggestions.");
        }

        benchSuggestionText.textContent = result.text;
        benchSuggestionOutput.hidden = false;
        benchSuggestionGenerate.textContent = "Regenerate Bench Suggestions";
      } catch {
        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Unable to generate bench suggestions.";
        }
        benchSuggestionGenerate.textContent = "Generate Bench Suggestions";
      } finally {
        benchSuggestionGenerate.disabled = false;
      }
    });

    benchSuggestionCopy?.addEventListener("click", async () => {
      const suggestionText = benchSuggestionText?.textContent?.trim() ?? "";

      if (!suggestionText) {
        return;
      }

      try {
        await navigator.clipboard.writeText(suggestionText);

        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Bench suggestions copied.";
        }
      } catch {
        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Unable to copy automatically.";
        }
      }
    });
  };

  const renderGearNeed = (need: GearNeedTarget) => `
    <span class="gear-need-item">${escapeHtml(need.item)}</span>
    <span class="gear-need-meta">${escapeHtml(need.category)} · ${escapeHtml(need.importance)} · ${escapeHtml(need.reason)}</span>
  `;

  const renderPlayerGearNeed = (player: PlayerGearNeed) => `
    <li class="gear-needs-player">
      <div class="gear-needs-player-heading">
        <a href="${escapeHtml(player.warcraftLogsUrl)}" target="_blank" rel="noreferrer">${escapeHtml(player.name)}</a>
        <span>${escapeHtml(player.spec)} ${escapeHtml(player.className)}</span>
      </div>
      <ul class="gear-needs-item-list">
        ${player.needs.map((need) => `<li>${renderGearNeed(need)}</li>`).join("")}
      </ul>
    </li>
  `;

  const renderGearNeedsReport = (report: GearNeedsReport) => `
    <div class="gear-needs-boss-list">
      ${report.bosses
        .map(
          (boss) => `
            <article class="gear-needs-boss">
              <div class="gear-needs-boss-heading">
                <div>
                  <p class="eyebrow">Boss ${escapeHtml(boss.order)}</p>
                  <h3>${escapeHtml(boss.bossName)}</h3>
                </div>
                <span class="gear-needs-boss-count">${escapeHtml(boss.stillNeedsCount)} open</span>
              </div>
              ${
                boss.stillNeeds.length > 0
                  ? `<ul class="gear-needs-player-list">${boss.stillNeeds.map(renderPlayerGearNeed).join("")}</ul>`
                  : `<p class="info-note gear-needs-empty">No tracked open needs from this boss.</p>`
              }
            </article>
          `,
        )
        .join("")}
    </div>

    <div class="gear-needs-notes">
      ${report.notes.map((note) => `<p class="info-note">${escapeHtml(note)}</p>`).join("")}
    </div>
  `;
  void renderGearNeedsReport;

  const getGearNeedsBossTabId = (bossName: string) =>
    `gear-needs-boss-${bossName.toLocaleLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`;

  const renderTabbedGearNeed = (need: GearNeedTarget) => `
    <span class="gear-need-item">${escapeHtml(need.item)}</span>
    <span class="gear-need-meta">${escapeHtml(need.slot)}</span>
  `;

  const renderTabbedAcquiredGear = (player: PlayerGearNeed) => {
    if (player.acquired.length === 0) {
      return "";
    }

    return `
      <ul class="gear-needs-acquired-list">
        ${player.acquired
          .map(
            (award) => `
              <li>
                <span>${escapeHtml(award.item)}</span>
                <span>${escapeHtml(award.responseType)} on ${escapeHtml(award.date)}</span>
              </li>
            `,
          )
          .join("")}
      </ul>
    `;
  };

  const renderTabbedRaiderCard = (player: PlayerGearNeed) => `
    <article class="gear-needs-raider-card" data-gear-status="${escapeHtml(player.status)}">
      <div class="gear-needs-player-heading">
        <div>
          <a href="${escapeHtml(player.warcraftLogsUrl)}" target="_blank" rel="noreferrer">${escapeHtml(player.name)}</a>
          <span>${escapeHtml(player.spec)} ${escapeHtml(player.className)}</span>
        </div>
      </div>
      ${
        player.needs.length > 0
          ? `<ul class="gear-needs-item-list">${player.needs.map((need) => `<li>${renderTabbedGearNeed(need)}</li>`).join("")}</ul>`
          : ""
      }
      ${renderTabbedAcquiredGear(player)}
    </article>
  `;

  const renderTabbedGearNeedsReport = (report: GearNeedsReport) => `
    <div class="gear-needs-tabs" role="tablist" aria-label="Boss gear needs">
      ${report.bosses
        .map((boss, index) => {
          const tabId = getGearNeedsBossTabId(boss.bossName);
          return `
            <button
              class="gear-needs-tab"
              type="button"
              role="tab"
              aria-selected="${index === 0 ? "true" : "false"}"
              aria-controls="${escapeHtml(tabId)}"
              data-gear-needs-tab="${escapeHtml(tabId)}"
            >
              <span>${escapeHtml(boss.bossName)}</span>
              <span>${escapeHtml(boss.stillNeedsCount)} open</span>
            </button>
          `;
        })
        .join("")}
    </div>

    <div class="gear-needs-boss-list">
      ${report.bosses
        .map((boss, index) => {
          const tabId = getGearNeedsBossTabId(boss.bossName);
          return `
            <article class="gear-needs-boss" id="${escapeHtml(tabId)}" role="tabpanel" ${index === 0 ? "" : "hidden"}>
              <div class="gear-needs-boss-heading">
                <div>
                  <p class="eyebrow">Boss ${escapeHtml(boss.order)}</p>
                  <h3>${escapeHtml(boss.bossName)}</h3>
                </div>
                <div class="gear-needs-boss-metrics">
                  <span>${escapeHtml(boss.players.length)} raiders</span>
                  <span>${escapeHtml(boss.stillNeedsCount)} open items</span>
                  <span>${escapeHtml(boss.safeCount)} clear/done</span>
                </div>
              </div>
              <div class="gear-needs-raider-grid">
                ${boss.players.map(renderTabbedRaiderCard).join("")}
              </div>
            </article>
          `;
        })
        .join("")}
    </div>

    <div class="gear-needs-notes">
      ${report.notes.map((note) => `<p class="info-note">${escapeHtml(note)}</p>`).join("")}
    </div>
  `;

  const bindGearNeedsTabs = (container: HTMLElement) => {
    const tabs = [...container.querySelectorAll<HTMLButtonElement>("[data-gear-needs-tab]")];
    const panels = [...container.querySelectorAll<HTMLElement>(".gear-needs-boss[role='tabpanel']")];

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const selectedPanelId = tab.dataset.gearNeedsTab ?? "";

        tabs.forEach((candidate) => {
          candidate.setAttribute("aria-selected", String(candidate === tab));
        });

        panels.forEach((panel) => {
          panel.hidden = panel.id !== selectedPanelId;
        });
      });
    });
  };

  const bindGearNeedsTool = () => {
    const gearNeedsTool = toolsRoot?.querySelector<HTMLElement>("[data-bench-suggestion-tool]");
    const gearNeedsLoad = gearNeedsTool?.querySelector<HTMLButtonElement>("[data-gear-needs-load]");
    const gearNeedsCopy = gearNeedsTool?.querySelector<HTMLButtonElement>("[data-gear-needs-copy]");
    const gearNeedsOutput = gearNeedsTool?.querySelector<HTMLElement>("[data-gear-needs-output]");
    const gearNeedsContent = gearNeedsTool?.querySelector<HTMLElement>("[data-gear-needs-content]");
    const gearNeedsText = gearNeedsTool?.querySelector<HTMLElement>("[data-gear-needs-text]");
    const gearNeedsStatus = gearNeedsTool?.querySelector<HTMLElement>("[data-gear-needs-status]");

    gearNeedsLoad?.addEventListener("click", async () => {
      if (!gearNeedsOutput || !gearNeedsContent || !gearNeedsText) {
        return;
      }

      gearNeedsLoad.disabled = true;
      gearNeedsLoad.textContent = "Loading...";

      if (gearNeedsStatus) {
        gearNeedsStatus.textContent = "";
      }

      try {
        const response = await fetch("/api/gear-needs");
        const result = await parseJsonResponse<{ ok?: boolean; report?: GearNeedsReport; text?: string; message?: string }>(response);

        if (!response.ok || result?.ok !== true || !result.report) {
          throw new Error(result?.message ?? "Unable to load gear needs.");
        }

        gearNeedsContent.innerHTML = renderTabbedGearNeedsReport(result.report);
        bindGearNeedsTabs(gearNeedsContent);
        gearNeedsText.textContent = result.text ?? "";
        gearNeedsOutput.hidden = false;
        gearNeedsLoad.textContent = "Reload Gear Needs";
      } catch {
        if (gearNeedsStatus) {
          gearNeedsStatus.textContent = "Unable to load gear needs.";
        }
        gearNeedsLoad.textContent = "Load Gear Needs";
      } finally {
        gearNeedsLoad.disabled = false;
      }
    });

    gearNeedsCopy?.addEventListener("click", async () => {
      const text = gearNeedsText?.textContent?.trim() ?? "";

      if (!text) {
        return;
      }

      try {
        await navigator.clipboard.writeText(text);

        if (gearNeedsStatus) {
          gearNeedsStatus.textContent = "Gear needs copied.";
        }
      } catch {
        if (gearNeedsStatus) {
          gearNeedsStatus.textContent = "Unable to copy automatically.";
        }
      }
    });
  };

  window.addEventListener("vitality:officer-unlocked", renderOfficerTools);
  window.addEventListener("vitality:officer-locked", () => {
    toolsRendered = false;

    if (toolsRoot) {
      toolsRoot.innerHTML = "";
    }
  });
</script>
