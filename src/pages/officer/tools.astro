---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Officer Tools | Vitality">
  <OfficerGate>
    <section data-officer-tools-root></section>
  </OfficerGate>
</Layout>

<script>
  const toolsRoot = document.querySelector<HTMLElement>("[data-officer-tools-root]");
  let toolsRendered = false;

  const parseJsonResponse = async <T,>(response: Response): Promise<T | undefined> => {
    const responseText = await response.text();

    if (!responseText) {
      return undefined;
    }

    try {
      return JSON.parse(responseText) as T;
    } catch {
      return undefined;
    }
  };

  const renderOfficerTools = () => {
    if (!toolsRoot || toolsRendered) {
      return;
    }

    toolsRendered = true;
    toolsRoot.innerHTML = `
      <section class="page-header officer-client-heading">
        <p class="eyebrow">Officer Tools</p>
        <h1 class="sr-only">Officer Tools</h1>
      </section>

      <nav class="officer-subnav" aria-label="Officer navigation">
        <span>Officer</span>
        <a href="/officer/tools" aria-current="page">Tools</a>
        <a href="/officer/roster">Roster</a>
      </nav>

      <section class="officer-tools-panel-group" data-bench-suggestion-tool>
        <div class="officer-tools-grid">
          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Sync Guild Data</p>
              <h2>Sync Guild Data</h2>
              <p class="info-note">
                Pull the latest Google Sheet data through GitHub Actions. If the sheet data changed,
                Cloudflare will redeploy after the data commit.
              </p>
            </div>

            <div class="officer-tool-actions">
              <div class="sync-trigger" data-sync-control>
                <button class="sync-trigger-button" type="button" data-sync-trigger>Sync Data</button>
                <span class="sync-trigger-status" data-sync-trigger-status aria-live="polite"></span>
              </div>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Bench Suggestions</p>
              <h2>Bench Suggestions</h2>
              <p class="info-note">
                Generate a draft bench plan using the current roster, calendar statuses, and Bench Rules.
                Review before copying into the Google Sheet.
              </p>
            </div>

            <div class="officer-tool-actions">
              <button class="filter-button is-subtle" type="button" data-bench-suggestion-generate>
                Generate Bench Suggestions
              </button>
            </div>
          </article>
        </div>

        <section class="panel bench-suggestion-output-panel" data-bench-suggestion-output hidden>
          <div class="section-heading inline bench-suggestion-heading">
            <div>
              <p class="eyebrow">Suggested Bench Plan</p>
              <h2>Suggested Bench Plan</h2>
            </div>
            <button class="filter-button is-subtle" type="button" data-bench-suggestion-copy>Copy</button>
          </div>

          <div class="bench-suggestion-output">
            <pre data-bench-suggestion-text></pre>
          </div>
          <p class="info-note bench-suggestion-status" data-bench-suggestion-status aria-live="polite"></p>
        </section>
      </section>
    `;

    bindSyncDataControl();
    bindBenchSuggestionTool();
  };

  const bindSyncDataControl = () => {
    const syncControl = toolsRoot?.querySelector<HTMLElement>("[data-sync-control]");
    const syncButton = syncControl?.querySelector<HTMLButtonElement>("[data-sync-trigger]");
    const syncStatus = syncControl?.querySelector<HTMLElement>("[data-sync-trigger-status]");
    let syncRequestInFlight = false;

    syncButton?.addEventListener("click", async () => {
      if (syncRequestInFlight) {
        return;
      }

      syncRequestInFlight = true;
      syncButton.disabled = true;
      syncButton.textContent = "Syncing...";

      if (syncStatus) {
        syncStatus.textContent = "";
        syncStatus.dataset.state = "";
      }

      try {
        const response = await fetch("/api/trigger-sync", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({}),
        });
        const result = await parseJsonResponse<{ ok?: boolean; message?: string }>(response);
        const isSuccess = response.ok && result?.ok === true;
        const message = isSuccess
          ? (result?.message ?? "Sync workflow triggered.")
          : (result?.message ?? "Unable to trigger sync workflow.");

        if (syncStatus) {
          syncStatus.textContent = message;
          syncStatus.dataset.state = isSuccess ? "success" : "error";
        }
      } catch {
        if (syncStatus) {
          syncStatus.textContent = "Unable to trigger sync workflow.";
          syncStatus.dataset.state = "error";
        }
      } finally {
        syncRequestInFlight = false;
        syncButton.disabled = false;
        syncButton.textContent = "Sync Data";
      }
    });
  };

  const bindBenchSuggestionTool = () => {
    const benchSuggestionTool = toolsRoot?.querySelector<HTMLElement>("[data-bench-suggestion-tool]");
    const benchSuggestionGenerate = benchSuggestionTool?.querySelector<HTMLButtonElement>("[data-bench-suggestion-generate]");
    const benchSuggestionCopy = benchSuggestionTool?.querySelector<HTMLButtonElement>("[data-bench-suggestion-copy]");
    const benchSuggestionOutput = benchSuggestionTool?.querySelector<HTMLElement>("[data-bench-suggestion-output]");
    const benchSuggestionText = benchSuggestionTool?.querySelector<HTMLElement>("[data-bench-suggestion-text]");
    const benchSuggestionStatus = benchSuggestionTool?.querySelector<HTMLElement>("[data-bench-suggestion-status]");

    benchSuggestionGenerate?.addEventListener("click", async () => {
      if (!benchSuggestionOutput || !benchSuggestionText) {
        return;
      }

      benchSuggestionGenerate.disabled = true;
      benchSuggestionGenerate.textContent = "Generating...";

      if (benchSuggestionStatus) {
        benchSuggestionStatus.textContent = "";
      }

      try {
        const response = await fetch("/api/bench-suggestions");
        const result = await parseJsonResponse<{ ok?: boolean; text?: string; message?: string }>(response);

        if (!response.ok || result?.ok !== true || !result.text) {
          throw new Error(result?.message ?? "Unable to generate bench suggestions.");
        }

        benchSuggestionText.textContent = result.text;
        benchSuggestionOutput.hidden = false;
        benchSuggestionGenerate.textContent = "Regenerate Bench Suggestions";
      } catch {
        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Unable to generate bench suggestions.";
        }
        benchSuggestionGenerate.textContent = "Generate Bench Suggestions";
      } finally {
        benchSuggestionGenerate.disabled = false;
      }
    });

    benchSuggestionCopy?.addEventListener("click", async () => {
      const suggestionText = benchSuggestionText?.textContent?.trim() ?? "";

      if (!suggestionText) {
        return;
      }

      try {
        await navigator.clipboard.writeText(suggestionText);

        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Bench suggestions copied.";
        }
      } catch {
        if (benchSuggestionStatus) {
          benchSuggestionStatus.textContent = "Unable to copy automatically.";
        }
      }
    });
  };

  window.addEventListener("vitality:officer-unlocked", renderOfficerTools);
</script>
