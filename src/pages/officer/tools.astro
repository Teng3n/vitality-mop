---
import OfficerGate from "../../components/OfficerGate.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Officer Tools | Vitality">
  <OfficerGate>
    <section data-officer-tools-root></section>
  </OfficerGate>
</Layout>

<script>
  const toolsRoot = document.querySelector<HTMLElement>("[data-officer-tools-root]");
  let toolsRendered = false;

  const parseJsonResponse = async <T,>(response: Response): Promise<T | undefined> => {
    const responseText = await response.text();

    if (!responseText) {
      return undefined;
    }

    try {
      return JSON.parse(responseText) as T;
    } catch {
      return undefined;
    }
  };

  const renderOfficerTools = () => {
    if (!toolsRoot || toolsRendered) {
      return;
    }

    toolsRendered = true;
    toolsRoot.innerHTML = `
      <section class="page-header officer-client-heading">
        <p class="eyebrow">Officer</p>
        <h1>Officer Tools</h1>
        <p>Officer utilities for data sync and bench planning.</p>
      </section>

      <section class="officer-tools-panel-group" data-bench-suggestion-tool>
        <div class="officer-tools-grid">
          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Sync Guild Data</p>
              <p class="info-note">
                Refresh roster, calendar, bench, and loot from Google Sheets.
              </p>
            </div>

            <div class="officer-tool-actions">
              <div class="sync-trigger" data-sync-control>
                <button class="sync-trigger-button" type="button" data-sync-trigger data-sync-type="sheets">Sync Guild Data</button>
                <span class="sync-trigger-status" data-sync-trigger-status aria-live="polite"></span>
              </div>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Warcraft Logs</p>
              <p class="info-note">
                Refresh progression data from Warcraft Logs.
              </p>
            </div>

            <div class="officer-tool-actions">
              <div class="sync-trigger" data-sync-control>
                <button class="sync-trigger-button" type="button" data-sync-trigger data-sync-type="wcl">Sync Warcraft Logs</button>
                <span class="sync-trigger-status" data-sync-trigger-status aria-live="polite"></span>
              </div>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Farm Bench Suggestions</p>
              <p class="info-note">
                Generate the original weekly bench plan from roster, calendar statuses, and Bench Rules.
              </p>
            </div>

            <div class="officer-tool-actions">
              <button
                class="filter-button is-subtle"
                type="button"
                data-bench-suggestion-generate
                data-bench-suggestion-kind="farm"
                data-bench-suggestion-endpoint="/api/bench-suggestions"
              >
                Generate Farm Suggestions
              </button>
            </div>
          </article>

          <article class="panel officer-tool-card">
            <div class="section-heading">
              <p class="eyebrow">Boss Bench Suggestions</p>
              <p class="info-note">
                Generate a boss-by-boss bench plan that prefers players without open BiS from each boss.
              </p>
            </div>

            <div class="officer-tool-actions">
              <button
                class="filter-button is-subtle"
                type="button"
                data-bench-suggestion-generate
                data-bench-suggestion-kind="boss"
                data-bench-suggestion-endpoint="/api/boss-bench-suggestions"
              >
                Generate Boss Suggestions
              </button>
            </div>
          </article>

        </div>

        <section class="panel bench-suggestion-output-panel" data-bench-suggestion-output="farm" hidden>
          <div class="section-heading inline bench-suggestion-heading">
            <div>
              <p class="eyebrow">Farm Suggested Bench Plan</p>
            </div>
            <button class="filter-button is-subtle" type="button" data-bench-suggestion-copy data-bench-suggestion-kind="farm">Copy</button>
          </div>

          <div class="bench-suggestion-output">
            <pre data-bench-suggestion-text="farm"></pre>
          </div>
          <p class="info-note bench-suggestion-status" data-bench-suggestion-status="farm" aria-live="polite"></p>
        </section>

        <section class="panel bench-suggestion-output-panel" data-bench-suggestion-output="boss" hidden>
          <div class="section-heading inline bench-suggestion-heading">
            <div>
              <p class="eyebrow">Boss Suggested Bench Plan</p>
            </div>
            <button class="filter-button is-subtle" type="button" data-bench-suggestion-copy data-bench-suggestion-kind="boss">Copy</button>
          </div>

          <div class="bench-suggestion-output">
            <pre data-bench-suggestion-text="boss"></pre>
          </div>
          <p class="info-note bench-suggestion-status" data-bench-suggestion-status="boss" aria-live="polite"></p>
        </section>
      </section>
    `;

    bindSyncControls();
    bindBenchSuggestionTool();
  };

  const bindSyncControls = () => {
    const syncControls = toolsRoot?.querySelectorAll<HTMLElement>("[data-sync-control]") ?? [];

    syncControls.forEach((syncControl) => {
      const syncButton = syncControl.querySelector<HTMLButtonElement>("[data-sync-trigger]");
      const syncStatus = syncControl.querySelector<HTMLElement>("[data-sync-trigger-status]");
      const syncType = syncButton?.dataset.syncType ?? "sheets";
      const defaultButtonText = syncButton?.textContent ?? "Sync";
      let syncRequestInFlight = false;

      syncButton?.addEventListener("click", async () => {
        if (syncRequestInFlight) {
          return;
        }

        syncRequestInFlight = true;
        syncButton.disabled = true;
        syncButton.textContent = "Syncing...";

        if (syncStatus) {
          syncStatus.textContent = "";
          syncStatus.dataset.state = "";
        }

        try {
          const response = await fetch("/api/trigger-sync", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ syncType }),
          });
          const result = await parseJsonResponse<{ ok?: boolean; message?: string }>(response);
          const isSuccess = response.ok && result?.ok === true;
          const message = isSuccess
            ? (result?.message ?? "Sync workflow triggered.")
            : (result?.message ?? "Unable to trigger sync workflow.");

          if (syncStatus) {
            syncStatus.textContent = message;
            syncStatus.dataset.state = isSuccess ? "success" : "error";
          }
        } catch {
          if (syncStatus) {
            syncStatus.textContent = "Unable to trigger sync workflow.";
            syncStatus.dataset.state = "error";
          }
        } finally {
          syncRequestInFlight = false;
          syncButton.disabled = false;
          syncButton.textContent = defaultButtonText;
        }
      });
    });
  };

  const bindBenchSuggestionTool = () => {
    const benchSuggestionTool = toolsRoot?.querySelector<HTMLElement>("[data-bench-suggestion-tool]");
    const benchSuggestionGenerateButtons =
      benchSuggestionTool?.querySelectorAll<HTMLButtonElement>("[data-bench-suggestion-generate]") ?? [];
    const benchSuggestionCopyButtons =
      benchSuggestionTool?.querySelectorAll<HTMLButtonElement>("[data-bench-suggestion-copy]") ?? [];

    const getSuggestionElements = (kind: string) => ({
      output: benchSuggestionTool?.querySelector<HTMLElement>(`[data-bench-suggestion-output="${kind}"]`),
      text: benchSuggestionTool?.querySelector<HTMLElement>(`[data-bench-suggestion-text="${kind}"]`),
      status: benchSuggestionTool?.querySelector<HTMLElement>(`[data-bench-suggestion-status="${kind}"]`),
    });

    benchSuggestionGenerateButtons.forEach((benchSuggestionGenerate) => {
      const kind = benchSuggestionGenerate.dataset.benchSuggestionKind ?? "farm";
      const endpoint = benchSuggestionGenerate.dataset.benchSuggestionEndpoint ?? "/api/bench-suggestions";
      const defaultButtonText = benchSuggestionGenerate.textContent ?? "Generate Suggestions";

      benchSuggestionGenerate.addEventListener("click", async () => {
        const { output, text, status } = getSuggestionElements(kind);

        if (!output || !text) {
          return;
        }

        benchSuggestionGenerate.disabled = true;
        benchSuggestionGenerate.textContent = "Generating...";

        if (status) {
          status.textContent = "";
        }

        try {
          const response = await fetch(endpoint);
          const result = await parseJsonResponse<{ ok?: boolean; text?: string; message?: string }>(response);

          if (!response.ok || result?.ok !== true || !result.text) {
            throw new Error(result?.message ?? "Unable to generate bench suggestions.");
          }

          text.textContent = result.text;
          output.hidden = false;
          benchSuggestionGenerate.textContent = `Regenerate ${kind === "boss" ? "Boss" : "Farm"} Suggestions`;
        } catch {
          if (status) {
            status.textContent = "Unable to generate bench suggestions.";
          }
          benchSuggestionGenerate.textContent = defaultButtonText;
        } finally {
          benchSuggestionGenerate.disabled = false;
        }
      });
    });

    benchSuggestionCopyButtons.forEach((benchSuggestionCopy) => {
      benchSuggestionCopy.addEventListener("click", async () => {
        const kind = benchSuggestionCopy.dataset.benchSuggestionKind ?? "farm";
        const { text, status } = getSuggestionElements(kind);
        const suggestionText = text?.textContent?.trim() ?? "";

        if (!suggestionText) {
          return;
        }

        try {
          await navigator.clipboard.writeText(suggestionText);

          if (status) {
            status.textContent = "Bench suggestions copied.";
          }
        } catch {
          if (status) {
            status.textContent = "Unable to copy automatically.";
          }
        }
      });
    });
  };

  window.addEventListener("vitality:officer-unlocked", renderOfficerTools);
  window.addEventListener("vitality:officer-locked", () => {
    toolsRendered = false;

    if (toolsRoot) {
      toolsRoot.innerHTML = "";
    }
  });
</script>
