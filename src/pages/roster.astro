---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import roster from "../data/roster.json";

const classColors: Record<string, string> = {
  "Death Knight": "#c41e3a",
  Druid: "#ff7c0a",
  Hunter: "#aad372",
  Mage: "#3fc7eb",
  Monk: "#00ff98",
  Paladin: "#f48cba",
  Priest: "#ffffff",
  Rogue: "#fff468",
  Shaman: "#0070dd",
  Warlock: "#8788ee",
  Warrior: "#c69b6d",
};

const members = [...roster].sort((a, b) => a.character.localeCompare(b.character, undefined, { sensitivity: "base" }));

const classColor = (className: string) => classColors[className] ?? "#f2f0e8";
---

<Layout title="Roster | Vitality">
  <PageHeader
    eyebrow="Roster"
    title="Raid Team"
    description="Current roster sorted alphabetically by character."
  />

  <section class="panel">
    <div class="section-heading inline">
      <div>
        <p class="eyebrow">Roster</p>
        <h2>{members.length} Characters</h2>
      </div>
    </div>
    <div class="table-shell">
      <table class="data-table roster-table">
        <thead>
          <tr>
            <th>Character</th>
            <th>Class</th>
            <th>Spec</th>
          </tr>
        </thead>
        <tbody>
          {
            members.map((member) => (
              <tr style={`--class-color: ${classColor(member.class)}`}>
                <td data-label="Character">
                  <strong>{member.character}</strong>
                </td>
                <td data-label="Class">{member.class}</td>
                <td data-label="Spec">{member.spec}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>
