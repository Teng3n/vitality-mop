---
import Layout from "../layouts/Layout.astro";
import NextRaidCard from "../components/NextRaidCard.astro";
import PageHeader from "../components/PageHeader.astro";
import RaidWindow from "../components/RaidWindow.astro";
import calendar from "../data/calendar.json";
import {
  getPlayersForStatusRange,
  getStatusTotals,
  getThisWeekRaidNights,
  type CalendarStatus,
  type StatusPlayer,
} from "../lib/guildData";
import { getPlayerClass, getPlayerNameStyle } from "../lib/playerStyles";

const calendarData = calendar as unknown as {
  raidDates: Array<{ label: string; isoDate: string }>;
  summary: Array<{ label: string; values: Record<string, string> }>;
  players: Array<{
    name: string;
    bis: number;
    major: number;
    minor: number;
    total: number;
    bonusRolls: number;
    offspec: number;
    mia: number;
    out: number;
    late: number;
    bench: number;
    schedule: Record<string, string>;
  }>;
};
const thisWeekRaidNights = getThisWeekRaidNights();
const thisWeekTotals = getStatusTotals(thisWeekRaidNights);
const thisWeekLabel = thisWeekRaidNights.map((night) => night.label).join(" / ");
const uniqueMissingStatusPlayers = [
  ...new Map(thisWeekRaidNights.flatMap((night) => night.missingStatusPlayers).map((player) => [player.slug, player])).values(),
];
const rosterIssuePlayers = [
  ...new Map(
    thisWeekRaidNights
      .flatMap((night) => [...night.bench, ...night.out, ...night.late, ...night.mia, ...night.trial])
      .filter((player) => !player.className)
      .map((player) => [player.slug, player]),
  ).values(),
];
const showPlayerList = (players: StatusPlayer[]) => players.slice(0, 8);
const statusList = (status: CalendarStatus) => showPlayerList(getPlayersForStatusRange(thisWeekRaidNights, status));
---

<Layout title="Raider Dashboard | Vitality">
  <PageHeader
    eyebrow="World of Warcraft MoP Classic"
    title="Raider Dashboard"
  />

  <NextRaidCard calendar={calendarData} />

  <section class="panel action-panel">
    <div class="section-heading inline">
      <div>
        <p class="eyebrow">Raid Lead Actions</p>
        <h2>This Week</h2>
      </div>
      <span class="muted">{thisWeekLabel || "No upcoming raid dates"}</span>
    </div>

    <div class="action-metrics">
      <div>
        <span>Bench</span>
        <strong>{thisWeekTotals.Bench}</strong>
      </div>
      <div>
        <span>Out</span>
        <strong>{thisWeekTotals.Out}</strong>
      </div>
      <div>
        <span>Trials</span>
        <strong>{thisWeekTotals.Trial}</strong>
      </div>
      <div>
        <span>Missing Status</span>
        <strong>{uniqueMissingStatusPlayers.length}</strong>
      </div>
      <div>
        <span>Roster Issues</span>
        <strong>{rosterIssuePlayers.length}</strong>
      </div>
    </div>

    <div class="action-columns">
      <article>
        <h3>Bench</h3>
        <ul class="inline-player-list">
          {
            statusList("Bench").map((player) => (
              <li>
                <a class="player-name" href={player.href} style={getPlayerNameStyle(player.name)} title={getPlayerClass(player.name)}>
                  {player.name}
                </a>
              </li>
            ))
          }
        </ul>
      </article>
      <article>
        <h3>Out / Late</h3>
        <ul class="inline-player-list">
          {
            [...statusList("Out"), ...statusList("Late")].map((player) => (
              <li>
                <a class="player-name" href={player.href} style={getPlayerNameStyle(player.name)} title={getPlayerClass(player.name)}>
                  {player.name}
                </a>
              </li>
            ))
          }
        </ul>
      </article>
      <article>
        <h3>Roster Issues</h3>
        {
          rosterIssuePlayers.length > 0 || uniqueMissingStatusPlayers.length > 0 ? (
            <ul class="inline-player-list">
              {[...rosterIssuePlayers, ...uniqueMissingStatusPlayers].map((player) => (
                <li>
                  <a class="player-name" href={player.href} style={getPlayerNameStyle(player.name)} title={getPlayerClass(player.name)}>
                    {player.name}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="info-note">No roster mismatches found for this week.</p>
          )
        }
      </article>
    </div>
  </section>

  <RaidWindow
    calendar={calendarData}
    summaryStrategy="raid-week"
    showSummaryCards={false}
    eyebrow="Raid Assignments"
    title="Current Calendar Snapshot"
  />
</Layout>
