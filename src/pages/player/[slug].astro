---
import Layout from "../../layouts/Layout.astro";
import StatCard from "../../components/StatCard.astro";
import { countsTowardMainSpecTotal } from "../../lib/guildData";
import { getPlayerNameStyle } from "../../lib/playerStyles";
import { getPlayerProfiles, type PlayerProfile } from "../../lib/playerProfiles";

export const getStaticPaths = () =>
  getPlayerProfiles().map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));

const { profile } = Astro.props as { profile: PlayerProfile };
const classSpec = [profile.className, profile.spec].filter(Boolean).join(" / ") || "Class and spec not listed";
const benchHistoryRows = profile.benchHistory.slice(0, 10);
const countedLootRows = profile.recentLoot.filter((row) => countsTowardMainSpecTotal(row.type)).slice(0, 12);
const otherLootRows = profile.recentLoot.filter((row) => !countsTowardMainSpecTotal(row.type)).slice(0, 12);
const recentLootRows = [...countedLootRows, ...otherLootRows];
---

<Layout title={`${profile.character} | Vitality`}>
  <section class="page-header">
    <p class="eyebrow">Player Profile</p>
    <h1 class="player-name" style={getPlayerNameStyle(profile.character)}>{profile.character}</h1>
  </section>

  <section class="panel profile-overview">
    <div>
      <p class="eyebrow">Character</p>
      <h2 class="profile-character player-name" style={getPlayerNameStyle(profile.character)}>{profile.character}</h2>
      <p class="muted">{profile.rosterStatus}</p>
    </div>
    <dl class="profile-meta">
      <div>
        <dt>Class / Spec</dt>
        <dd>{classSpec}</dd>
      </div>
      <div>
        <dt>Role</dt>
        <dd>{profile.role ?? "Not listed"}</dd>
      </div>
    </dl>
  </section>

  <section class="dashboard-grid">
    <StatCard label="Bench" value={profile.attendance.bench} detail="Bench marks" />
    <StatCard label="Out" value={profile.attendance.out} detail="Out marks" />
    <StatCard label="Late" value={profile.attendance.late} detail="Late marks" />
    <StatCard label="MIA" value={profile.attendance.mia} detail="MIA marks" />
  </section>

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Attendance</p>
        <h2>Calendar Summary</h2>
      </div>
      <ul class="clean-list profile-list">
        <li><span>Bench</span><strong>{profile.attendance.bench}</strong></li>
        <li><span>Out</span><strong>{profile.attendance.out}</strong></li>
        <li><span>Late</span><strong>{profile.attendance.late}</strong></li>
        <li><span>MIA</span><strong>{profile.attendance.mia}</strong></li>
      </ul>
    </article>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Bench</p>
        <h2>Upcoming Bench Dates</h2>
      </div>
      {
        profile.upcomingBenchDates.length > 0 ? (
          <ul class="clean-list profile-list">
            {profile.upcomingBenchDates.map((date) => (
              <li>
                <span>{date.label}</span>
                <strong>{date.isoDate}</strong>
              </li>
            ))}
          </ul>
        ) : (
          <p class="info-note">No upcoming bench dates listed.</p>
        )
      }
    </article>
  </section>

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Loot</p>
        <h2>Loot Summary</h2>
      </div>
      <ul class="clean-list profile-list">
        <li><span>BiS</span><strong>{profile.lootSummary.bis}</strong></li>
        <li><span>Major</span><strong>{profile.lootSummary.major}</strong></li>
        <li><span>Minor</span><strong>{profile.lootSummary.minor}</strong></li>
        <li><span>Offspec</span><strong>{profile.lootSummary.offspec}</strong></li>
        <li><span>Bonus Rolls</span><strong>{profile.lootSummary.bonusRolls}</strong></li>
        <li><span>Total</span><strong>{profile.lootSummary.total}</strong></li>
      </ul>
    </article>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Notes</p>
        <h2>Status & Links</h2>
      </div>
      <ul class="clean-list">
        {profile.notes.map((note) => <li>{note}</li>)}
      </ul>
      <div class="profile-actions">
        <a class="resource-link" href={profile.warcraftLogsDirectUrl ?? profile.warcraftLogsUrl} target="_blank" rel="noreferrer">
          <span>View on Warcraft Logs</span>
          <small>{profile.warcraftLogsDirectUrl ? "Open character profile" : "Search this character"}</small>
        </a>
      </div>
    </article>
  </section>

  <section class="panel">
    <div class="section-heading inline">
      <div>
        <p class="eyebrow">Bench</p>
        <h2>Bench Rotation</h2>
      </div>
      <div class="profile-bench-count">
        <span>Total Bench Count</span>
        <strong>{profile.benchHistory.length + profile.upcomingBenchDates.length}</strong>
      </div>
    </div>
    {
      benchHistoryRows.length > 0 ? (
        <ul class="clean-list profile-list">
          {benchHistoryRows.map((date) => (
            <li>
              <span>{date.label}</span>
              <strong>{date.isoDate}</strong>
            </li>
          ))}
        </ul>
      ) : (
        <p class="info-note">No bench history listed.</p>
      )
    }
  </section>

  <section class="panel">
    <div class="section-heading inline">
      <div>
        <p class="eyebrow">Recent Loot</p>
        <h2>Latest Awards</h2>
      </div>
      {
        otherLootRows.length > 0 && (
          <label class="check-field">
            <input type="checkbox" data-profile-loot-toggle />
            <span>Show all loot</span>
          </label>
        )
      }
    </div>
    <div class="table-shell">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Item</th>
            <th>Boss</th>
            <th>Instance</th>
            <th>Type</th>
          </tr>
        </thead>
        <tbody>
          {
            recentLootRows.length > 0 ? (
              recentLootRows.map((row) => {
                const isCounted = countsTowardMainSpecTotal(row.type);

                return (
                  <tr data-profile-loot-row data-counted-loot={String(isCounted)} hidden={!isCounted}>
                    <td data-label="Date">{row.date}</td>
                    <td data-label="Item">{row.item}</td>
                    <td data-label="Boss">{row.boss}</td>
                    <td data-label="Instance">{row.instance}</td>
                    <td data-label="Type">{row.type}</td>
                  </tr>
                );
              })
            ) : (
              <tr>
                <td colspan={5}>No recent loot listed.</td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLInputElement>("[data-profile-loot-toggle]").forEach((toggle) => {
    const panel = toggle.closest(".panel");
    const rows = Array.from(panel?.querySelectorAll<HTMLTableRowElement>("[data-profile-loot-row]") ?? []);

    const updateRows = () => {
      for (const row of rows) {
        row.hidden = row.dataset.countedLoot !== "true" && !toggle.checked;
      }
    };

    toggle.addEventListener("change", updateRows);
    updateRows();
  });
</script>
