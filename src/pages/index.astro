---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout title="Vitality | MoP Classic Guild">
  <PageHeader
    eyebrow="World of Warcraft MoP Classic"
    title="Vitality"
    description="Raid planning, roster visibility, loot summaries, and bench rotation for the team."
  />

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Raid Schedule</p>
        <h2>Weekly Raid Nights</h2>
      </div>
      <ul class="schedule-list">
        <li>
          <span>Sunday</span>
          <strong>8:00 PM - 11:00 PM PST</strong>
        </li>
        <li>
          <span>Monday</span>
          <strong>8:00 PM - 11:00 PM PST</strong>
        </li>
      </ul>
    </article>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Recruitment</p>
        <h2>Discord and Applications</h2>
      </div>
      <div class="cta-stack">
        <a class="button" href="https://discord.gg/Eg3UkkgcGj">Discord</a>
        <a class="button secondary" href="https://forms.gle/Ka2nMVkdp5wNCjZq8">Application</a>
      </div>
    </article>
  </section>
</Layout>
