---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getPlayerClass, getPlayerNameStyle } from "../lib/playerStyles";

const discordUrl = "https://discord.gg/Eg3UkkgcGj";

const leaders = [
  { role: "Guild Master", name: "Tengen" },
  { role: "Officer", name: "DrChicken" },
  { role: "Officer", name: "Karkan" },
];

const expectations = [
  "Attend at least 90% of raids with absences and tardiness communicated in a timely manner.",
  "Arrive fully prepared with consumables, gems, enchants, and strong class knowledge.",
  "Maintain comprehensive knowledge of boss mechanics.",
  "Keep a positive attitude and be willing to accept constructive feedback.",
  "Participate in a rotating bench when needed.",
];

const addons = [
  { name: "WeakAuras", url: "https://www.curseforge.com/wow/addons/weakauras-2" },
  { name: "GTFO", url: "https://www.curseforge.com/wow/addons/gtfo" },
  { name: "MRT", url: "https://www.curseforge.com/wow/addons/method-raid-tools" },
  { name: "RCLootCouncil", url: "https://www.curseforge.com/wow/addons/rclootcouncil-classic" },
];

const finalProgress = [
  { label: "Siege of Orgrimmar", detail: "14/14 Heroic" },
  { label: "Garrosh Hellscream", detail: "First defeated September 8, 2026" },
];
---

<Layout title="Vitality | MoP Classic Guild Archive">
  <PageHeader
    eyebrow="Guild Archive"
    title="Vitality"
  />

  <section class="content-grid two-column">
    <article class="panel copy-panel">
      <div class="section-heading">
        <p class="eyebrow">Mists of Pandaria Classic</p>
        <h2>Heroic Garrosh Defeated</h2>
      </div>
      <div class="info-copy">
        <p>
          Vitality completed its Mists of Pandaria Classic raid campaign by defeating Garrosh
          Hellscream on Heroic difficulty. Active raiding concluded in September 2026, and this
          site is now preserved as a historical record of the team.
        </p>
        <p>
          Vitality has a rich history of raiding and friendships dating back to the original
          vanilla World of Warcraft. The core team raided together from Warlords of Draenor
          through Classic, building a friendly, inclusive, and high-performing community along
          the way.
        </p>
        <p>
          The roster, progression, loot history, raid notes, and officer tools remain intact for
          reference. Live scheduling pages are no longer linked, and automated data refreshes have
          been retired.
        </p>
      </div>
    </article>

    <div class="stack homepage-side-stack">
      <article class="panel resources-panel">
        <div class="section-heading">
          <p class="eyebrow">Resources</p>
          <h2>Quick Links</h2>
        </div>
        <div class="resource-list compact">
          <a class="resource-link" href={discordUrl}>
            <span>Discord</span>
            <small>Community server</small>
          </a>
          <a class="resource-link" href="/progression">
            <span>Progression Archive</span>
            <small>Boss kills across every Classic era</small>
          </a>
          <a class="resource-link" href="/roster">
            <span>Final Roster</span>
            <small>MoP Classic team snapshot</small>
          </a>
        </div>
      </article>

      <article class="panel">
        <div class="section-heading">
          <p class="eyebrow">Historical Schedule</p>
          <h2>Final Raid Nights</h2>
        </div>
        <ul class="schedule-list">
          <li>
            <span>Sunday</span>
            <strong>8:00 PM - 11:00 PM PT</strong>
          </li>
          <li>
            <span>Monday</span>
            <strong>8:00 PM - 11:00 PM PT</strong>
          </li>
        </ul>
      </article>
    </div>
  </section>

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Leadership</p>
        <h2>Final Officer Team</h2>
      </div>
      <ul class="clean-list leadership-list">
        {
          leaders.map((leader) => (
            <li>
              <span>{leader.role}</span>
              <strong
                class="player-name"
                style={getPlayerNameStyle(leader.name)}
                title={getPlayerClass(leader.name)}
              >
                {leader.name}
              </strong>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Final Tier</p>
        <h2>Campaign Result</h2>
      </div>
      <ul class="clean-list recruitment-list">
        {
          finalProgress.map((result) => (
            <li>
              <span>{result.label}</span>
              <strong>{result.detail}</strong>
            </li>
          ))
        }
      </ul>
    </article>
  </section>

  <section class="content-grid two-column">
    <div class="stack">
      <article class="panel copy-panel">
        <div class="section-heading">
          <p class="eyebrow">Historical Loot System</p>
          <h2>Loot Council</h2>
        </div>
        <p class="info-note">Performance, attendance, and contribution-based Loot Council.</p>
        <p class="info-note">Always considering exceptional players regardless of class or spec.</p>
      </article>

      <article class="panel">
        <div class="section-heading">
          <p class="eyebrow">Historical Add-ons</p>
          <h2>Raid Tools</h2>
        </div>
        <ul class="clean-list addon-list">
          {addons.map((addon) => <li><a href={addon.url}>{addon.name}</a></li>)}
        </ul>
      </article>
    </div>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Raider Expectations</p>
        <h2>Historical Team Standards</h2>
      </div>
      <ul class="clean-list expectation-list">
        {expectations.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>
</Layout>
