---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout title="Vitality | MoP Classic Guild">
  <PageHeader
    eyebrow="World of Warcraft MoP Classic"
    title="Vitality"
    description="Raid planning, roster visibility, loot summaries, and bench rotation for the team."
  />

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Raid Schedule</p>
        <h2>Weekly Raid Nights</h2>
      </div>
      <ul class="schedule-list">
        <li>
          <span>Sunday</span>
          <strong>8:00 PM - 11:00 PM PST</strong>
        </li>
        <li>
          <span>Monday</span>
          <strong>8:00 PM - 11:00 PM PST</strong>
        </li>
      </ul>
    </article>

    <article class="panel resources-panel">
      <div class="section-heading">
        <p class="eyebrow">Resources</p>
        <h2>Guild Links</h2>
      </div>
      <div class="resource-list">
        <a class="resource-link" href="https://discord.gg/Eg3UkkgcGj">
          <span>Discord</span>
          <small>Voice and guild chat</small>
        </a>
        <a class="resource-link" href="/calendar">
          <span>Raid Assignments</span>
          <small>Calendar and bench view</small>
        </a>
        <a class="resource-link" href="https://forms.gle/Ka2nMVkdp5wNCjZq8">
          <span>Apply Here</span>
          <small>Guild application</small>
        </a>
        <span class="resource-link is-pending">
          <span>Guild Info</span>
          <small>Coming soon</small>
        </span>
      </div>
    </article>
  </section>
</Layout>
