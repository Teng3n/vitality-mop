---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import StatCard from "../components/StatCard.astro";
import roster from "../data/roster.json";
import lootSummary from "../data/lootSummary.json";
import bench from "../data/bench.json";

const coreCount = roster.length;
const lootTotal = lootSummary.reduce((sum, row) => sum + row.total, 0);
const nextBench = [...bench].sort((a, b) => b.totalBenchCount - a.totalBenchCount)[0];
---

<Layout title="Vitality | MoP Classic Guild">
  <PageHeader
    eyebrow="World of Warcraft MoP Classic"
    title="Vitality"
    description="Raid planning, roster visibility, loot summaries, and bench rotation for the team."
  />

  <section class="dashboard-grid compact">
    <StatCard label="Active roster" value={coreCount} detail="Current raid team" href="/roster" />
    <StatCard label="Tracked loot" value={lootTotal} detail="Player-level total" href="/loot" />
    <StatCard label="Bench priority" value={nextBench?.player ?? "-"} detail="Next rotation note" href="/bench" />
  </section>

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Raid Schedule</p>
        <h2>Weekly Raid Nights</h2>
      </div>
      <ul class="schedule-list">
        <li>
          <span>Wednesday</span>
          <strong>7:30 PM server</strong>
          <small>Progression night</small>
        </li>
        <li>
          <span>Sunday</span>
          <strong>7:30 PM server</strong>
          <small>Farm / cleanup night</small>
        </li>
      </ul>
    </article>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Recruitment</p>
        <h2>Discord and Applications</h2>
      </div>
      <div class="cta-stack">
        <a class="button" href="#">Discord</a>
        <a class="button secondary" href="#">Recruitment</a>
      </div>
      <p class="muted">Public invite and application links coming soon.</p>
    </article>
  </section>

  <section class="link-grid" aria-label="Guild sections">
    <a href="/roster">Roster</a>
    <a href="/loot">Loot Summary</a>
    <a href="/loot/history">Loot History</a>
    <a href="/bench">Bench</a>
  </section>
</Layout>
