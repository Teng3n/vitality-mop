---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getPlayerClass, getPlayerNameStyle } from "../lib/playerStyles";

const discordUrl = "https://discord.gg/Eg3UkkgcGj";
const applicationUrl = "https://forms.gle/Ka2nMVkdp5wNCjZq8";

const leaders = [
  { role: "Guild Master", name: "Tengen" },
  { role: "Officer", name: "DrChicken" },
  { role: "Officer", name: "Karkan" },
];

const expectations = [
  "Attend at least 90% of raids with absences and tardiness communicated in a timely manner.",
  "Arrive fully prepared with consumables, gems, enchants, and strong class knowledge.",
  "Maintain comprehensive knowledge of boss mechanics.",
  "Keep a positive attitude and be willing to accept constructive feedback.",
  "Participate in a rotating bench when needed.",
];

const addons = [
  { name: "WeakAuras", url: "https://www.curseforge.com/wow/addons/weakauras-2" },
  { name: "GTFO", url: "https://www.curseforge.com/wow/addons/gtfo" },
  { name: "MRT", url: "https://www.curseforge.com/wow/addons/method-raid-tools" },
  { name: "RCLootCouncil", url: "https://www.curseforge.com/wow/addons/rclootcouncil-classic" },
];
---

<Layout title="Vitality | MoP Classic Guild">
  <PageHeader
    eyebrow="World of Warcraft MoP Classic"
    title="Vitality"
    description="A semi-hardcore raiding community focused on efficient clears, steady progression, and a friendly team culture."
  />

  <section class="content-grid two-column">
    <article class="panel copy-panel">
      <div class="section-heading">
        <p class="eyebrow">Welcome</p>
        <h2>Welcome to Vitality</h2>
      </div>
      <div class="info-copy">
        <p>
          Our guild is a semi-hardcore raiding community founded on day one of World of
          Warcraft: Classic on the Fairbanks server. Our goal is to clear current content in a
          timely and efficient manner.
        </p>
        <p>
          Vitality has a rich history of raiding and friendships dating back to the original
          vanilla World of Warcraft. Our core team has been raiding together since Warlords of
          Draenor, and we strive to maintain a friendly, inclusive, and high-performing community
          that helps its members achieve their raiding goals.
        </p>
        <p>
          If you are interested in joining our guild, please contact Tengen or any of our officers.
          We welcome both guild and non-guild members to join our Discord server and participate in
          community activities.
        </p>
      </div>
    </article>

    <article class="panel resources-panel">
      <div class="section-heading">
        <p class="eyebrow">Resources</p>
        <h2>Quick Links</h2>
      </div>
      <div class="resource-list">
        <a class="resource-link" href={discordUrl}>
          <span>Discord</span>
          <small>Community and raid voice</small>
        </a>
        <a class="resource-link" href={applicationUrl}>
          <span>Apply Here</span>
          <small>Guild application</small>
        </a>
        <a class="resource-link" href="/dashboard">
          <span>Raider Dashboard</span>
          <small>Next raid and calendar snapshot</small>
        </a>
        <a class="resource-link" href="/calendar">
          <span>Raid Assignments</span>
          <small>Full calendar history</small>
        </a>
      </div>
    </article>
  </section>

  <section class="content-grid two-column">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Leadership</p>
        <h2>Officer Team</h2>
      </div>
      <ul class="clean-list leadership-list">
        {
          leaders.map((leader) => (
            <li>
              <span>{leader.role}</span>
              <strong
                class="player-name"
                style={getPlayerNameStyle(leader.name)}
                title={getPlayerClass(leader.name)}
              >
                {leader.name}
              </strong>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Raid Times</p>
        <h2>Weekly Raid Nights</h2>
      </div>
      <ul class="schedule-list">
        <li>
          <span>Sunday</span>
          <strong>8:00 PM - 11:00 PM PT</strong>
        </li>
        <li>
          <span>Monday</span>
          <strong>8:00 PM - 11:00 PM PT</strong>
        </li>
      </ul>
    </article>
  </section>

  <section class="content-grid two-column">
    <div class="stack">
      <article class="panel copy-panel">
        <div class="section-heading">
          <p class="eyebrow">Loot System</p>
          <h2>Loot Council</h2>
        </div>
        <p class="info-note">Performance, attendance, and contribution-based Loot Council.</p>
        <p class="info-note">Always considering exceptional players regardless of class or spec.</p>
      </article>

      <article class="panel">
        <div class="section-heading">
          <p class="eyebrow">Required Add-ons</p>
          <h2>Raid Tools</h2>
        </div>
        <ul class="clean-list addon-list">
          {addons.map((addon) => <li><a href={addon.url}>{addon.name}</a></li>)}
        </ul>
      </article>
    </div>

    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Raider Expectations</p>
        <h2>Team Standards</h2>
      </div>
      <ul class="clean-list expectation-list">
        {expectations.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>
</Layout>
